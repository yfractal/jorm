# Listen address (default 127.0.0.1:8787)
JO_PROXY_HOST=127.0.0.1
JO_PROXY_PORT=8787

# Request/response recording to GreptimeDB (see docker-compose.yml +
# bin/migrate). On by default -- set JO_DB_RECORD=0 to disable.
# JO_DB_RECORD=0
# GREPTIMEDB_HOST=127.0.0.1
# GREPTIMEDB_PORT=4003
# GREPTIMEDB_DATABASE=public
# GREPTIMEDB_USER=
# GREPTIMEDB_PASSWORD=

# Also dump request/response metadata to JSON files (off by default,
# coexists with GreptimeDB recording above).
# JO_DUMP=1
# JO_DUMP_DIR=./dumps
