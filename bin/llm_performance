#!/usr/bin/env ruby
# frozen_string_literal: true

# Serves an HTML report of LLM proxy performance: traffic, latency, TTFT,
# tokens/sec, token breakdown (input / output / cached / reasoning),
# errors and retries.
#
# Reads from GreptimeDB's HTTP SQL API (default :4000) -- no `pg` gem
# needed, only Ruby stdlib + WEBrick.
#
# Timing / retry columns (ttft_ms, duration_ms, retry_count, error) are
# written by the proxy starting with the capture change; older rows leave
# those as NULL and are excluded from latency stats. Token counts and
# model come from the reassembled response body.
#
# Usage:
#   bin/llm_performance
#   JO_REPORT_PORT=4891 bin/llm_performance
# Then open http://127.0.0.1:4891/

require "cgi"
require "json"
require "net/http"
require "time"
require "uri"
require "webrick"

REPORT_HOST = ENV.fetch("JO_REPORT_HOST", "127.0.0.1")
REPORT_PORT = Integer(ENV.fetch("JO_REPORT_PORT", "4891"))
GREPTIME_HOST = ENV.fetch("GREPTIMEDB_HTTP_HOST", "127.0.0.1")
GREPTIME_PORT = Integer(ENV.fetch("GREPTIMEDB_HTTP_PORT", "4000"))
GREPTIME_DB = ENV.fetch("GREPTIMEDB_DATABASE", "jorm")

RANGE_PRESETS = {
  "1h" => 3600,
  "6h" => 6 * 3600,
  "24h" => 24 * 3600,
  "7d" => 7 * 24 * 3600
}.freeze

DEFAULT_RANGE = "24h"
MAX_RECENT_ERRORS = 25
CHART_WIDTH = 720
CHART_HEIGHT = 180

# ---------------------------------------------------------------------------
# GreptimeDB HTTP SQL client
# ---------------------------------------------------------------------------

def sql_query(sql)
  uri = URI("http://#{GREPTIME_HOST}:#{GREPTIME_PORT}/v1/sql")
  uri.query = URI.encode_www_form(db: GREPTIME_DB, sql: sql)

  response = Net::HTTP.get_response(uri)
  raise "GreptimeDB HTTP #{response.code}: #{response.body[0, 500]}" unless response.is_a?(Net::HTTPSuccess)

  data = JSON.parse(response.body)
  records = data.dig("output", 0, "records")
  return [] unless records

  columns = records.dig("schema", "column_schemas")&.map { |c| c["name"] } || []
  (records["rows"] || []).map { |row| columns.zip(row).to_h }
end

def sql_literal(value)
  "'#{value.to_s.gsub("'", "''")}'"
end

def parse_time_param(raw)
  return nil if raw.nil? || raw.strip.empty?

  Time.parse(raw)
rescue ArgumentError
  nil
end

def parse_json_maybe(value)
  case value
  when Hash, Array then value
  when String
    return nil if value.empty?

    JSON.parse(value)
  end
rescue JSON::ParserError
  nil
end

def to_time(value)
  case value
  when nil then nil
  when Time then value.utc
  when Integer then Time.at(value > 1_000_000_000_000 ? value / 1000.0 : value).utc
  else
    Time.parse(value.to_s).utc
  end
rescue ArgumentError
  nil
end

def to_f_or_nil(value)
  return nil if value.nil? || value.to_s.empty?

  Float(value)
rescue ArgumentError, TypeError
  nil
end

def to_i_or_zero(value)
  Integer(value || 0)
rescue ArgumentError, TypeError
  0
end

# ---------------------------------------------------------------------------
# Fetch / normalize rows
# ---------------------------------------------------------------------------

def resolve_range(preset:, from_raw:, to_raw:)
  from_time = parse_time_param(from_raw)
  to_time = parse_time_param(to_raw)
  return [from_time, to_time, nil] if from_time || to_time

  seconds = RANGE_PRESETS[preset] || RANGE_PRESETS[DEFAULT_RANGE]
  [Time.now.utc - seconds, Time.now.utc, preset]
end

def fetch_rows(from_time:, to_time:)
  clauses = ["1 = 1"]
  clauses << "resp.created_at >= #{sql_literal(from_time.utc.iso8601)}" if from_time
  clauses << "resp.created_at <= #{sql_literal(to_time.utc.iso8601)}" if to_time

  sql = <<~SQL
    SELECT resp.created_at, resp.status, resp.ttft_ms, resp.duration_ms,
           resp.retry_count, resp.error, resp.body,
           r.body AS req_body
    FROM responses resp
    LEFT JOIN requests r ON r.jorm_request_id = resp.jorm_request_id
    WHERE #{clauses.join(" AND ")}
    ORDER BY resp.created_at ASC
  SQL

  sql_query(sql)
end

def extract_think_effort(req_body)
  body = parse_json_maybe(req_body)
  return "(none)" unless body.is_a?(Hash)

  if (effort = body["reasoning_effort"])
    return effort.to_s
  end
  if (effort = body.dig("reasoning", "effort"))
    return effort.to_s
  end

  thinking = body["thinking"]
  case thinking
  when nil
    "(none)"
  when false
    "disabled"
  when true
    "enabled"
  when Hash
    if thinking["type"].to_s == "disabled"
      "disabled"
    elsif thinking.key?("budget_tokens")
      "budget:#{thinking["budget_tokens"]}"
    elsif thinking["type"]
      thinking["type"].to_s
    else
      thinking.inspect
    end
  else
    thinking.to_s
  end
end

def normalize_row(row)
  body = parse_json_maybe(row["body"])
  usage = body.is_a?(Hash) ? body["usage"] : nil
  usage = {} unless usage.is_a?(Hash)

  input = to_i_or_zero(usage["input_tokens"])
  output = to_i_or_zero(usage["output_tokens"])
  cache_read = to_i_or_zero(usage["cache_read_input_tokens"])
  cache_creation = to_i_or_zero(usage["cache_creation_input_tokens"])
  details = usage["output_tokens_details"]
  reasoning = details.is_a?(Hash) ? to_i_or_zero(details["thinking_tokens"]) : 0

  status = to_i_or_zero(row["status"])
  error = row["error"]
  error = nil if error.respond_to?(:empty?) && error.empty?
  is_error = !error.nil? || status >= 400

  ttft_ms = to_f_or_nil(row["ttft_ms"])
  duration_ms = to_f_or_nil(row["duration_ms"])
  tokens_per_sec = compute_tokens_per_sec(output, duration_ms, ttft_ms)

  {
    "created_at" => to_time(row["created_at"]),
    "status" => status,
    "ttft_ms" => ttft_ms,
    "duration_ms" => duration_ms,
    "retry_count" => to_i_or_zero(row["retry_count"]),
    "error" => error,
    "is_error" => is_error,
    "model" => body.is_a?(Hash) ? body["model"].to_s : "",
    "think_effort" => extract_think_effort(row["req_body"]),
    "input_tokens" => input,
    "output_tokens" => output,
    "cache_read_tokens" => cache_read,
    "cache_creation_tokens" => cache_creation,
    "reasoning_tokens" => reasoning,
    "tokens_per_sec" => tokens_per_sec
  }
end

def compute_tokens_per_sec(output_tokens, duration_ms, ttft_ms)
  return nil if output_tokens <= 0 || duration_ms.nil? || duration_ms <= 0

  gen_ms = if ttft_ms && ttft_ms > 0 && duration_ms > ttft_ms
             duration_ms - ttft_ms
           else
             duration_ms
           end
  return nil if gen_ms <= 0

  (output_tokens / (gen_ms / 1000.0)).round(2)
end

# ---------------------------------------------------------------------------
# Aggregation
# ---------------------------------------------------------------------------

def percentile(values, p)
  return nil if values.nil? || values.empty?

  sorted = values.sort
  return sorted.first if sorted.length == 1

  rank = (p / 100.0) * (sorted.length - 1)
  low = rank.floor
  high = rank.ceil
  return sorted[low] if low == high

  sorted[low] + (sorted[high] - sorted[low]) * (rank - low)
end

def choose_bucket_seconds(from_time, to_time)
  span = [(to_time || Time.now.utc) - (from_time || (Time.now.utc - 3600)), 60].max
  case span
  when 0...3 * 3600 then 60
  when 3 * 3600...24 * 3600 then 5 * 60
  when 24 * 3600...3 * 24 * 3600 then 30 * 60
  else 3600
  end
end

def bucket_key(time, bucket_seconds)
  return nil unless time

  epoch = time.to_i
  Time.at(epoch - (epoch % bucket_seconds)).utc
end

def build_buckets(rows, from_time, to_time)
  bucket_seconds = choose_bucket_seconds(from_time, to_time)
  buckets = Hash.new do |h, k|
    h[k] = {
      "t" => k,
      "requests" => 0,
      "errors" => 0,
      "retries" => 0,
      "ttft" => [],
      "duration" => [],
      "tokens_per_sec" => [],
      "input_tokens" => 0,
      "output_tokens" => 0,
      "cache_read_tokens" => 0,
      "cache_creation_tokens" => 0,
      "reasoning_tokens" => 0
    }
  end

  rows.each do |row|
    key = bucket_key(row["created_at"], bucket_seconds)
    next unless key

    b = buckets[key]
    b["requests"] += 1
    b["errors"] += 1 if row["is_error"]
    b["retries"] += row["retry_count"]
    b["ttft"] << row["ttft_ms"] if row["ttft_ms"]
    b["duration"] << row["duration_ms"] if row["duration_ms"]
    b["tokens_per_sec"] << row["tokens_per_sec"] if row["tokens_per_sec"]
    b["input_tokens"] += row["input_tokens"]
    b["output_tokens"] += row["output_tokens"]
    b["cache_read_tokens"] += row["cache_read_tokens"]
    b["cache_creation_tokens"] += row["cache_creation_tokens"]
    b["reasoning_tokens"] += row["reasoning_tokens"]
  end

  # Fill empty buckets across the range so the chart has a continuous x-axis.
  if from_time && to_time
    t = bucket_key(from_time, bucket_seconds)
    end_t = bucket_key(to_time, bucket_seconds)
    while t && end_t && t <= end_t
      buckets[t]
      t += bucket_seconds
    end
  end

  {
    "bucket_seconds" => bucket_seconds,
    "buckets" => buckets.keys.sort.map { |k| buckets[k] }
  }
end

def build_summary(rows)
  ttfts = rows.filter_map { |r| r["ttft_ms"] }
  durations = rows.filter_map { |r| r["duration_ms"] }
  tps = rows.filter_map { |r| r["tokens_per_sec"] }
  errors = rows.count { |r| r["is_error"] }
  retries = rows.sum { |r| r["retry_count"] }

  {
    "requests" => rows.size,
    "errors" => errors,
    "error_rate" => rows.empty? ? 0.0 : (100.0 * errors / rows.size),
    "retries" => retries,
    "ttft_p50" => percentile(ttfts, 50),
    "ttft_p95" => percentile(ttfts, 95),
    "duration_p50" => percentile(durations, 50),
    "duration_p95" => percentile(durations, 95),
    "tokens_per_sec_avg" => tps.empty? ? nil : (tps.sum / tps.size.to_f),
    "input_tokens" => rows.sum { |r| r["input_tokens"] },
    "output_tokens" => rows.sum { |r| r["output_tokens"] },
    "cache_read_tokens" => rows.sum { |r| r["cache_read_tokens"] },
    "cache_creation_tokens" => rows.sum { |r| r["cache_creation_tokens"] },
    "reasoning_tokens" => rows.sum { |r| r["reasoning_tokens"] }
  }
end

def aggregate_metric_rows(group_rows, extras = {})
  ttfts = group_rows.filter_map { |r| r["ttft_ms"] }
  tps = group_rows.filter_map { |r| r["tokens_per_sec"] }
  errors = group_rows.count { |r| r["is_error"] }
  extras.merge(
    "requests" => group_rows.size,
    "ttft_p50" => percentile(ttfts, 50),
    "tokens_per_sec_avg" => tps.empty? ? nil : (tps.sum / tps.size.to_f),
    "error_rate" => group_rows.empty? ? 0.0 : (100.0 * errors / group_rows.size),
    "input_tokens" => group_rows.sum { |r| r["input_tokens"] },
    "output_tokens" => group_rows.sum { |r| r["output_tokens"] },
    "cache_read_tokens" => group_rows.sum { |r| r["cache_read_tokens"] },
    "reasoning_tokens" => group_rows.sum { |r| r["reasoning_tokens"] }
  )
end

def build_per_model(rows)
  by_model = Hash.new { |h, k| h[k] = [] }
  rows.each do |row|
    model = row["model"].to_s
    model = "(unknown)" if model.empty?
    by_model[model] << row
  end

  by_model.map do |model, model_rows|
    aggregate_metric_rows(model_rows, "model" => model)
  end
end

# Same metrics as per-model, grouped by model + think effort (from the
# request body's thinking / reasoning_effort fields).
def build_per_model_effort(rows)
  by_key = Hash.new { |h, k| h[k] = [] }
  rows.each do |row|
    model = row["model"].to_s
    model = "(unknown)" if model.empty?
    by_key[[model, row["think_effort"]]] << row
  end

  by_key.map do |(model, effort), group_rows|
    aggregate_metric_rows(group_rows, "model" => model, "think_effort" => effort)
  end
end

def efforts_for_model(effort_rows, model, sort_key, sort_dir)
  subset = effort_rows.select { |r| r["model"] == model }
  child_sort = sort_key == "model" ? "think_effort" : sort_key
  child_dir = sort_key == "model" ? "asc" : sort_dir
  sort_models(subset, child_sort, child_dir)
end

MODEL_SORT_COLUMNS = {
  "model" => { label: "Name", numeric: false },
  "think_effort" => { label: "Think", numeric: false },
  "ttft_p50" => { label: "TTFT p50", numeric: true },
  "tokens_per_sec_avg" => { label: "Tok/s", numeric: true },
  "error_rate" => { label: "Error %", numeric: true },
  "requests" => { label: "Reqs", numeric: true },
  "input_tokens" => { label: "Input", numeric: true },
  "output_tokens" => { label: "Output", numeric: true },
  "cache_read_tokens" => { label: "Cached", numeric: true },
  "reasoning_tokens" => { label: "Reasoning", numeric: true }
}.freeze

MODEL_COLUMN_ORDER = %w[
  model ttft_p50 tokens_per_sec_avg error_rate
  requests input_tokens output_tokens cache_read_tokens reasoning_tokens
].freeze

DEFAULT_MODEL_SORT = "requests"
DEFAULT_MODEL_DIR = "desc"

def normalize_model_sort(sort_raw, dir_raw)
  sort = MODEL_SORT_COLUMNS.key?(sort_raw.to_s) ? sort_raw.to_s : DEFAULT_MODEL_SORT
  dir = %w[asc desc].include?(dir_raw.to_s) ? dir_raw.to_s : DEFAULT_MODEL_DIR
  [sort, dir]
end

def sort_models(models, sort_key, dir)
  numeric = MODEL_SORT_COLUMNS.fetch(sort_key)[:numeric]
  models.sort do |a, b|
    av = a[sort_key]
    bv = b[sort_key]
    if av.nil? && bv.nil?
      0
    elsif av.nil?
      1
    elsif bv.nil?
      -1
    else
      cmp = if numeric
              av.to_f <=> bv.to_f
            else
              av.to_s.downcase <=> bv.to_s.downcase
            end
      dir == "desc" ? -cmp : cmp
    end
  end
end

def build_error_breakdown(rows)
  counts = Hash.new(0)
  rows.each do |row|
    next unless row["is_error"]

    key = row["error"].to_s
    key = "http_#{row["status"]}" if key.empty?
    counts[key] += 1
  end
  counts.sort_by { |_, n| -n }.map { |msg, n| { "error" => msg, "count" => n } }
end

def recent_failures(rows)
  rows
    .select { |r| r["is_error"] || r["retry_count"].positive? }
    .sort_by { |r| r["created_at"] || Time.at(0) }
    .reverse
    .first(MAX_RECENT_ERRORS)
end

def available_models(rows)
  rows.map { |r| r["model"] }.reject(&:empty?).uniq.sort
end

# ---------------------------------------------------------------------------
# Formatting
# ---------------------------------------------------------------------------

def h(text)
  CGI.escapeHTML(text.to_s)
end

def format_ms(ms)
  return "n/a" if ms.nil?

  if ms >= 1000
    format("%.2fs", ms / 1000.0)
  else
    format("%.0fms", ms)
  end
end

def format_rate(rate)
  format("%.1f%%", rate)
end

def format_tps(tps)
  return "n/a" if tps.nil?

  format("%.1f", tps)
end

def format_int(n)
  n.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
end

def format_ts(time)
  return "—" unless time

  time.utc.strftime("%Y-%m-%d %H:%M:%S UTC")
end

def format_bucket_label(time, bucket_seconds)
  return "" unless time

  if bucket_seconds < 3600
    time.strftime("%H:%M")
  elsif bucket_seconds < 24 * 3600
    time.strftime("%m-%d %H:%M")
  else
    time.strftime("%m-%d")
  end
end

def datetime_local_value(time)
  return nil unless time

  time.getlocal.strftime("%Y-%m-%dT%H:%M")
end

def query_string(params)
  pairs = params.compact.filter_map do |k, v|
    next if v.nil? || v.to_s.empty?

    "#{CGI.escape(k.to_s)}=#{CGI.escape(v.to_s)}"
  end
  pairs.empty? ? "" : "?#{pairs.join("&")}"
end

# ---------------------------------------------------------------------------
# SVG charts
# ---------------------------------------------------------------------------

def svg_bar_chart(buckets, value_key:, error_key: nil, height: CHART_HEIGHT, width: CHART_WIDTH)
  return empty_chart_svg("No data") if buckets.empty?

  values = buckets.map { |b| b[value_key].to_f }
  errors = error_key ? buckets.map { |b| b[error_key].to_f } : Array.new(buckets.size, 0.0)
  max_v = [values.max || 0, 1].max
  pad_l = 36
  pad_r = 12
  pad_t = 12
  pad_b = 28
  plot_w = width - pad_l - pad_r
  plot_h = height - pad_t - pad_b
  gap = 2.0
  bar_w = [(plot_w.to_f / buckets.size) - gap, 1].max

  bars = buckets.each_with_index.map do |b, i|
    x = pad_l + i * (bar_w + gap)
    ok = [values[i] - errors[i], 0].max
    err = errors[i]
    ok_h = plot_h * (ok / max_v)
    err_h = plot_h * (err / max_v)
    y_ok = pad_t + plot_h - ok_h - err_h
    y_err = pad_t + plot_h - err_h
    parts = []
    if ok_h > 0
      parts << %(<rect x="#{x.round(1)}" y="#{y_ok.round(1)}" width="#{bar_w.round(1)}" height="#{ok_h.round(1)}" fill="#2563eb" rx="1"/>)
    end
    if err_h > 0
      parts << %(<rect x="#{x.round(1)}" y="#{y_err.round(1)}" width="#{bar_w.round(1)}" height="#{err_h.round(1)}" fill="#dc2626" rx="1"/>)
    end
    parts.join
  end.join

  labels = axis_labels(buckets, pad_l, bar_w + gap, pad_t + plot_h + 14)
  y_labels = [
    %(<text x="#{pad_l - 6}" y="#{pad_t + 4}" text-anchor="end" class="chart-label">#{max_v.round}</text>),
    %(<text x="#{pad_l - 6}" y="#{pad_t + plot_h}" text-anchor="end" class="chart-label">0</text>)
  ].join

  <<~SVG
    <svg viewBox="0 0 #{width} #{height}" width="100%" role="img" aria-label="Traffic chart" class="chart">
      <line x1="#{pad_l}" y1="#{pad_t}" x2="#{pad_l}" y2="#{pad_t + plot_h}" stroke="currentColor" stroke-opacity="0.2"/>
      <line x1="#{pad_l}" y1="#{pad_t + plot_h}" x2="#{width - pad_r}" y2="#{pad_t + plot_h}" stroke="currentColor" stroke-opacity="0.2"/>
      #{y_labels}
      #{bars}
      #{labels}
    </svg>
  SVG
end

def svg_line_chart(buckets, series:, height: CHART_HEIGHT, width: CHART_WIDTH)
  # series: [{key:, label:, color:, aggregator: ->(b){...}}]
  return empty_chart_svg("No timing data") if buckets.empty?

  all_values = series.flat_map { |s| buckets.filter_map { |b| s[:aggregator].call(b) } }
  return empty_chart_svg("No timing data") if all_values.empty?

  max_v = [all_values.max, 1].max
  pad_l = 48
  pad_r = 12
  pad_t = 12
  pad_b = 28
  plot_w = width - pad_l - pad_r
  plot_h = height - pad_t - pad_b
  step = buckets.size <= 1 ? 0 : plot_w.to_f / (buckets.size - 1)

  paths = series.map do |s|
    points = buckets.each_with_index.filter_map do |b, i|
      v = s[:aggregator].call(b)
      next unless v

      x = pad_l + i * step
      y = pad_t + plot_h - (plot_h * (v / max_v))
      [x, y]
    end
    next if points.empty?

    d = points.each_with_index.map { |(x, y), i| "#{i.zero? ? "M" : "L"}#{x.round(1)},#{y.round(1)}" }.join(" ")
    %(<path d="#{d}" fill="none" stroke="#{s[:color]}" stroke-width="2"/>)
  end.compact.join

  legend = series.each_with_index.map do |s, i|
    x = pad_l + i * 140
    %(<rect x="#{x}" y="4" width="10" height="10" fill="#{s[:color]}" rx="1"/><text x="#{x + 14}" y="13" class="chart-label">#{h(s[:label])}</text>)
  end.join

  labels = axis_labels(buckets, pad_l, step.zero? ? plot_w : step, pad_t + plot_h + 14)
  y_labels = [
    %(<text x="#{pad_l - 6}" y="#{pad_t + 4}" text-anchor="end" class="chart-label">#{format_ms(max_v)}</text>),
    %(<text x="#{pad_l - 6}" y="#{pad_t + plot_h}" text-anchor="end" class="chart-label">0</text>)
  ].join

  <<~SVG
    <svg viewBox="0 0 #{width} #{height}" width="100%" role="img" aria-label="Latency chart" class="chart">
      <line x1="#{pad_l}" y1="#{pad_t}" x2="#{pad_l}" y2="#{pad_t + plot_h}" stroke="currentColor" stroke-opacity="0.2"/>
      <line x1="#{pad_l}" y1="#{pad_t + plot_h}" x2="#{width - pad_r}" y2="#{pad_t + plot_h}" stroke="currentColor" stroke-opacity="0.2"/>
      #{y_labels}
      #{paths}
      #{labels}
      #{legend}
    </svg>
  SVG
end

def svg_stacked_token_chart(buckets, height: CHART_HEIGHT, width: CHART_WIDTH)
  return empty_chart_svg("No token data") if buckets.empty?

  layers = [
    { key: "input_tokens", color: "#2563eb", label: "input" },
    { key: "output_tokens", color: "#16a34a", label: "output" },
    { key: "cache_read_tokens", color: "#ca8a04", label: "cached" },
    { key: "reasoning_tokens", color: "#9333ea", label: "reasoning" }
  ]
  totals = buckets.map { |b| layers.sum { |l| b[l[:key]].to_f } }
  max_v = [totals.max || 0, 1].max

  pad_l = 48
  pad_r = 12
  pad_t = 20
  pad_b = 28
  plot_w = width - pad_l - pad_r
  plot_h = height - pad_t - pad_b
  gap = 2.0
  bar_w = [(plot_w.to_f / buckets.size) - gap, 1].max

  bars = buckets.each_with_index.map do |b, i|
    x = pad_l + i * (bar_w + gap)
    y = pad_t + plot_h
    layers.map do |layer|
      v = b[layer[:key]].to_f
      next if v <= 0

      hgt = plot_h * (v / max_v)
      y -= hgt
      %(<rect x="#{x.round(1)}" y="#{y.round(1)}" width="#{bar_w.round(1)}" height="#{hgt.round(1)}" fill="#{layer[:color]}"/>)
    end.compact.join
  end.join

  legend = layers.each_with_index.map do |l, i|
    x = pad_l + i * 110
    %(<rect x="#{x}" y="4" width="10" height="10" fill="#{l[:color]}" rx="1"/><text x="#{x + 14}" y="13" class="chart-label">#{l[:label]}</text>)
  end.join

  labels = axis_labels(buckets, pad_l, bar_w + gap, pad_t + plot_h + 14)

  <<~SVG
    <svg viewBox="0 0 #{width} #{height}" width="100%" role="img" aria-label="Token chart" class="chart">
      <line x1="#{pad_l}" y1="#{pad_t}" x2="#{pad_l}" y2="#{pad_t + plot_h}" stroke="currentColor" stroke-opacity="0.2"/>
      <line x1="#{pad_l}" y1="#{pad_t + plot_h}" x2="#{width - pad_r}" y2="#{pad_t + plot_h}" stroke="currentColor" stroke-opacity="0.2"/>
      #{bars}
      #{labels}
      #{legend}
    </svg>
  SVG
end

def axis_labels(buckets, pad_l, step, y)
  return "" if buckets.empty?

  count = [buckets.size, 6].min
  indexes = if buckets.size == 1
              [0]
            else
              (0...count).map { |i| (i * (buckets.size - 1).to_f / (count - 1)).round }.uniq
            end
  indexes.map do |i|
    x = pad_l + i * step
    label = format_bucket_label(buckets[i]["t"], 1)
    %(<text x="#{x.round(1)}" y="#{y}" text-anchor="middle" class="chart-label">#{h(label)}</text>)
  end.join
end

def empty_chart_svg(message)
  <<~SVG
    <svg viewBox="0 0 #{CHART_WIDTH} #{CHART_HEIGHT}" width="100%" class="chart chart-empty" role="img">
      <text x="50%" y="50%" text-anchor="middle" class="chart-label">#{h(message)}</text>
    </svg>
  SVG
end

