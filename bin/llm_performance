BRUSH_AND_TOGGLE_JS = <<~JS
  (function () {
    const paramsEl = document.getElementById("jorm-page-params");
    const pageParams = paramsEl ? JSON.parse(paramsEl.textContent || "{}") : {};

    const navigateTimeRange = (from, to) => {
      const params = new URLSearchParams();
      Object.entries(pageParams || {}).forEach(([k, v]) => {
        if (v != null && v !== "") params.set(k, v);
      });
      if (from && to) {
        params.set("from", from);
        params.set("to", to);
      } else {
        params.delete("from");
        params.delete("to");
      }
      const qs = params.toString();
      window.location.search = qs ? ("?" + qs) : "";
    };

    const resetTimeRange = () => navigateTimeRange(null, null);
    window.jormNavigateTimeRange = navigateTimeRange;
    window.jormResetTimeRange = resetTimeRange;

    const indexFromClientX = (el, clientX, count) => {
      const rect = el.getBoundingClientRect();
      if (rect.width <= 0 || count <= 0) return 0;
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      return Math.min(count - 1, Math.max(0, Math.round(ratio * (count - 1))));
    };

    document.querySelectorAll(".chart-brush").forEach((el) => {
      let data;
      try { data = JSON.parse(el.getAttribute("data-brush") || "{}"); }
      catch (_) { return; }
      const stamps = data.timestamps || [];
      const ends = data.timestampEnds || [];
      if (!stamps.length) return;

      const rect = el.querySelector(".brush-rect");
      let dragging = false;
      let startX = 0;

      const showRect = (x0, x1) => {
        if (!rect) return;
        const left = Math.min(x0, x1);
        const width = Math.abs(x1 - x0);
        rect.style.left = left + "px";
        rect.style.width = Math.max(width, 2) + "px";
        rect.style.display = "block";
      };

      el.addEventListener("mousedown", (e) => {
        if (e.button !== 0) return;
        dragging = true;
        startX = e.clientX - el.getBoundingClientRect().left;
        showRect(startX, startX);
        e.preventDefault();
      });

      window.addEventListener("mousemove", (e) => {
        if (!dragging) return;
        const x = e.clientX - el.getBoundingClientRect().left;
        showRect(startX, x);
      });

      window.addEventListener("mouseup", (e) => {
        if (!dragging) return;
        dragging = false;
        if (rect) rect.style.display = "none";
        const endX = e.clientX;
        const i0 = indexFromClientX(el, Math.min(startX + el.getBoundingClientRect().left, endX), stamps.length);
        const i1 = indexFromClientX(el, Math.max(startX + el.getBoundingClientRect().left, endX), stamps.length);
        if (Math.abs(endX - (startX + el.getBoundingClientRect().left)) < 8) return;
        navigateTimeRange(stamps[i0], ends[i1] || ends[i0] || stamps[i0]);
      });

      el.addEventListener("dblclick", (e) => {
        e.preventDefault();
        resetTimeRange();
      });
    });

    document.querySelectorAll("button.model-toggle").forEach((btn) => {
      btn.addEventListener("click", () => {
        const model = btn.getAttribute("data-model") || "";
        const row = btn.closest("tr");
        if (!row) return;
        const expanded = row.classList.toggle("expanded");
        btn.setAttribute("aria-expanded", expanded ? "true" : "false");
        const marker = btn.querySelector(".toggle-marker");
        if (marker) marker.textContent = expanded ? "▾" : "▸";
        document.querySelectorAll("tr.effort-row").forEach((child) => {
          if (child.getAttribute("data-parent") !== model) return;
          child.hidden = !expanded;
        });
      });
    });
  })();
JS

def render_page(rows:, summary:, buckets_info:, models:, effort_rows:,
                error_breakdown:, failures:,
                range_preset:, from_raw:, to_raw:, from_time:, to_time:, model_filter:,
                available_models:, sort_key:, sort_dir:,
                model_timeseries:, error: nil)
  filters_active = !model_filter.to_s.empty? || !from_raw.to_s.empty? || !to_raw.to_s.empty? ||
                   (range_preset && range_preset != DEFAULT_RANGE)
  custom_range = !(from_raw.to_s.empty? && to_raw.to_s.empty?)

  base_params = {
    range: range_preset,
    from: from_raw,
    to: to_raw,
    model: model_filter,
    sort: sort_key,
    dir: sort_dir
  }

  body_html =
    if error
      render_error_state(error)
    elsif rows.empty?
      render_empty_state(filters_active: filters_active)
    else
      render_dashboard(
        summary: summary,
        buckets_info: buckets_info,
        models: models,
        effort_rows: effort_rows,
        error_breakdown: error_breakdown,
        failures: failures,
        base_params: base_params,
        sort_key: sort_key,
        sort_dir: sort_dir,
        model_timeseries: model_timeseries,
        custom_range: custom_range,
        range_preset: range_preset
      )
    end

  preset_links = RANGE_PRESETS.keys.map do |key|
    cls = (range_preset == key && from_raw.to_s.empty? && to_raw.to_s.empty?) ? "active" : ""
    href = query_string(base_params.merge(range: key, from: nil, to: nil))
    %(<a class="#{cls}" href="/#{h(href)}">#{key}</a>)
  end.join

  model_options = [%(<option value="">All models</option>)] +
                  available_models.map do |m|
                    selected = m == model_filter ? " selected" : ""
                    %(<option value="#{h(m)}"#{selected}>#{h(m)}</option>)
                  end

  page_params_json = JSON.generate(
    "range" => (range_preset || DEFAULT_RANGE).to_s,
    "model" => model_filter.to_s,
    "sort" => sort_key.to_s,
    "dir" => sort_dir.to_s
  )

  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>LLM performance — jorm</title>
      <style>#{PAGE_CSS}</style>
      <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.2.0/dist/chartjs-plugin-zoom.min.js"></script>
    </head>
    <body>
      <header class="page-header">
        <h1>LLM performance</h1>
        <p class="subtitle">
          Traffic, latency, TTFT, tokens/sec and token breakdown from proxied responses.
          #{if DEMO_MODE
              "Demo mode — serving synthetic data from <code>#{h(DEMO_FIXTURE.basename)}</code>."
            else
              "Metric columns require a recent proxy; older rows may lack model/token stats."
            end}
        </p>
      </header>

      <form class="filter" method="get" action="/">
        <div class="field">
          <label>Range</label>
          <div class="presets">#{preset_links}</div>
        </div>
        <div class="field">
          <label for="from">From</label>
          <input id="from" type="datetime-local" name="from" value="#{h(datetime_local_value(from_time) || from_raw.to_s)}">
        </div>
        <div class="field">
          <label for="to">To</label>
          <input id="to" type="datetime-local" name="to" value="#{h(datetime_local_value(to_time) || to_raw.to_s)}">
        </div>
        <div class="field">
          <label for="model">Model</label>
          <select id="model" name="model">#{model_options.join}</select>
        </div>
        <input type="hidden" name="range" value="#{h(range_preset || DEFAULT_RANGE)}">
        <input type="hidden" name="sort" value="#{h(sort_key)}">
        <input type="hidden" name="dir" value="#{h(sort_dir)}">
        <div class="field field-actions">
          <button type="submit" class="btn btn-primary">Apply</button>
          #{%(<a href="/" class="btn btn-ghost">Reset</a>) if filters_active}
        </div>
      </form>

      <main>
        #{body_html}
      </main>
      <script type="application/json" id="jorm-page-params">#{page_params_json}</script>
      <script>#{BRUSH_AND_TOGGLE_JS}</script>
    </body>
    </html>
  HTML
end

def render_dashboard(summary:, buckets_info:, models:, effort_rows:,
                     error_breakdown:, failures:,
                     base_params:, sort_key:, sort_dir:, model_timeseries:,
                     custom_range:, range_preset:)
  buckets = buckets_info["buckets"]
  bucket_seconds = buckets_info["bucket_seconds"]
  brush = bucket_brush_times(buckets, bucket_seconds)

  traffic_svg = wrap_brushable(
    svg_bar_chart(buckets, value_key: "requests", error_key: "errors"),
    timestamps: brush["timestamps"],
    timestamp_ends: brush["timestamp_ends"]
  )
  latency_svg = wrap_brushable(
    svg_line_chart(
      buckets,
      series: [
        { label: "TTFT p50", color: "#2563eb", aggregator: ->(b) { percentile(b["ttft"], 50) } },
        { label: "TTFT p95", color: "#93c5fd", aggregator: ->(b) { percentile(b["ttft"], 95) } },
        { label: "Total p50", color: "#16a34a", aggregator: ->(b) { percentile(b["duration"], 50) } },
        { label: "Total p95", color: "#86efac", aggregator: ->(b) { percentile(b["duration"], 95) } }
      ]
    ),
    timestamps: brush["timestamps"],
    timestamp_ends: brush["timestamp_ends"]
  )
  tps_svg = wrap_brushable(
    svg_line_chart(
      buckets,
      series: [
        {
          label: "tokens/sec avg",
          color: "#ca8a04",
          aggregator: lambda { |b|
            vals = b["tokens_per_sec"]
            vals.empty? ? nil : vals.sum / vals.size.to_f
          }
        }
      ]
    ),
    timestamps: brush["timestamps"],
    timestamp_ends: brush["timestamp_ends"]
  )
  tokens_svg = wrap_brushable(
    svg_stacked_token_chart(buckets),
    timestamps: brush["timestamps"],
    timestamp_ends: brush["timestamp_ends"]
  )

  reset_href = query_string(base_params.merge(from: nil, to: nil, range: range_preset || DEFAULT_RANGE))
  zoom_hint = <<~HTML
    <div class="zoom-hint">
      <span><strong>Drag</strong> on any chart to select a time range · <strong>double-click</strong> to reset</span>
      #{if custom_range
          %(<a class="btn btn-ghost" href="/#{h(reset_href)}">Reset zoom</a>)
        end}
    </div>
  HTML

  <<~HTML
    #{zoom_hint}
    <section class="stats" aria-label="Summary">
      <div class="stat stat-primary">
        <span class="stat-value">#{format_int(summary["requests"])}</span>
        <span class="stat-label">Requests</span>
      </div>
      <div class="stat #{summary["errors"].positive? ? "stat-warn" : ""}">
        <span class="stat-value">#{h(format_rate(summary["error_rate"]))}</span>
        <span class="stat-label">Error rate (#{summary["errors"]})</span>
      </div>
      <div class="stat">
        <span class="stat-value">#{format_int(summary["retries"])}</span>
        <span class="stat-label">Retries</span>
      </div>
      <div class="stat">
        <span class="stat-value">#{h(format_ms(summary["ttft_p50"]))}</span>
        <span class="stat-label">TTFT p50</span>
      </div>
      <div class="stat">
        <span class="stat-value">#{h(format_ms(summary["ttft_p95"]))}</span>
        <span class="stat-label">TTFT p95</span>
      </div>
      <div class="stat">
        <span class="stat-value">#{h(format_ms(summary["duration_p50"]))}</span>
        <span class="stat-label">Latency p50</span>
      </div>
      <div class="stat">
        <span class="stat-value">#{h(format_ms(summary["duration_p95"]))}</span>
        <span class="stat-label">Latency p95</span>
      </div>
      <div class="stat">
        <span class="stat-value">#{h(format_tps(summary["tokens_per_sec_avg"]))}</span>
        <span class="stat-label">Tokens/sec avg</span>
      </div>
    </section>

    <div class="grid">
      <section class="panel panel-full">
        <h2>Model Performance Metrics</h2>
        <p class="panel-hint">One line per model over time · drag any chart to zoom the whole page</p>
        #{render_per_model_chart(model_timeseries)}
        #{render_model_table(
          models,
          effort_rows: effort_rows,
          base_params: base_params,
          sort_key: sort_key,
          sort_dir: sort_dir
        )}
      </section>

      <section class="panel">
        <h2>Traffic</h2>
        <p class="panel-hint">Requests per bucket · red = errors</p>
        #{traffic_svg}
        <div class="legend-row">
          <span><span class="swatch" style="background:#2563eb"></span>ok</span>
          <span><span class="swatch" style="background:#dc2626"></span>errors</span>
        </div>
      </section>

      <section class="panel">
        <h2>Latency</h2>
        <p class="panel-hint">TTFT and total latency percentiles over time</p>
        #{latency_svg}
      </section>

      <section class="panel">
        <h2>Tokens / sec</h2>
        <p class="panel-hint">output_tokens / generation time (duration − TTFT)</p>
        #{tps_svg}
      </section>

      <section class="panel">
        <h2>Tokens</h2>
        <div class="token-pills">
          <span class="pill"><strong>#{format_int(summary["input_tokens"])}</strong> input</span>
          <span class="pill"><strong>#{format_int(summary["output_tokens"])}</strong> output</span>
          <span class="pill"><strong>#{format_int(summary["cache_read_tokens"])}</strong> cached</span>
          <span class="pill"><strong>#{format_int(summary["cache_creation_tokens"])}</strong> cache write</span>
          <span class="pill"><strong>#{format_int(summary["reasoning_tokens"])}</strong> reasoning</span>
        </div>
        #{tokens_svg}
      </section>

      <section class="panel">
        <h2>Errors</h2>
        #{render_error_breakdown(error_breakdown)}
      </section>

      <section class="panel">
        <h2>Recent failures &amp; retries</h2>
        #{render_failures(failures)}
      </section>
    </div>
  HTML
end

def render_error_breakdown(rows)
  return %(<p class="muted">No errors in this range.</p>) if rows.empty?

  body = rows.map do |r|
    <<~HTML
      <tr>
        <td class="mono error-text">#{h(r["error"])}</td>
        <td class="num">#{r["count"]}</td>
      </tr>
    HTML
  end.join

  <<~HTML
    <table>
      <thead><tr><th>Error</th><th class="num">Count</th></tr></thead>
      <tbody>#{body}</tbody>
    </table>
  HTML
end

def render_failures(rows)
  return %(<p class="muted">No failures or retries in this range.</p>) if rows.empty?

  body = rows.map do |r|
    err = r["error"].to_s
    err = "http_#{r["status"]}" if err.empty? && r["is_error"]
    err = "—" if err.empty?
    <<~HTML
      <tr>
        <td class="mono">#{h(format_ts(r["created_at"]))}</td>
        <td class="mono">#{h(r["model"].empty? ? "—" : r["model"])}</td>
        <td class="num">#{r["status"]}</td>
        <td class="num">#{r["retry_count"]}</td>
        <td class="mono error-text">#{h(err)}</td>
      </tr>
    HTML
  end.join

  <<~HTML
    <table>
      <thead>
        <tr>
          <th>Time</th><th>Model</th><th class="num">Status</th>
          <th class="num">Retries</th><th>Error</th>
        </tr>
      </thead>
      <tbody>#{body}</tbody>
    </table>
  HTML
end

def short_model_label(model)
  name = model.to_s
  return name if name.length <= 28

  "#{name[0, 25]}…"
end

def render_per_model_chart(timeseries)
  series = timeseries["series"] || []
  return %(<p class="muted">No model data.</p>) if series.empty? || timeseries["labels"].empty?

  payload = {
    labels: timeseries["labels"],
    timestamps: timeseries["timestamps"],
    timestampEnds: timeseries["timestamp_ends"],
    series: series.map do |s|
      {
        name: s["name"],
        label: s["label"],
        color: s["color"],
        ttftSeconds: s["ttft_s"],
        tokensPerSec: s["tps"]
      }
    end
  }

  <<~HTML
    <p class="chart-title">Tok/s</p>
    <div class="chart-wrap">
      <canvas id="per-model-tps-chart" aria-label="Per model tokens per second over time"></canvas>
    </div>
    <p class="chart-title">TTFT p50</p>
    <div class="chart-wrap">
      <canvas id="per-model-ttft-chart" aria-label="Per model TTFT over time"></canvas>
    </div>
    <script>
      (function () {
        const data = #{JSON.generate(payload)};
        if (typeof Chart === "undefined") return;

        const fmtTtft = (v) => {
          if (v == null || Number.isNaN(v)) return "n/a";
          return v >= 1 ? v.toFixed(2) + "s" : Math.round(v * 1000) + "ms";
        };
        const fmtTps = (v) => (v == null || Number.isNaN(v) ? "n/a" : v.toFixed(1) + " tok/s");

        const applyBrush = (chart) => {
          const x = chart.scales.x;
          if (!x || !data.timestamps || data.timestamps.length === 0) return;
          let i0 = Math.floor(Math.min(x.min, x.max));
          let i1 = Math.ceil(Math.max(x.min, x.max));
          i0 = Math.max(0, i0);
          i1 = Math.min(data.timestamps.length - 1, i1);
          if (i1 <= i0) i1 = Math.min(data.timestamps.length - 1, i0 + 1);
          const navigate = window.jormNavigateTimeRange;
          if (typeof navigate === "function") {
            navigate(data.timestamps[i0], data.timestampEnds[i1]);
          }
        };

        const lineDatasets = (valueKey) => data.series.map((s) => ({
          label: s.label,
          data: s[valueKey],
          borderColor: s.color,
          backgroundColor: s.color,
          pointBackgroundColor: s.color,
          pointRadius: 3,
          pointHoverRadius: 5,
          tension: 0.25,
          spanGaps: true,
          fullName: s.name
        }));

        const commonOptions = (tooltipFmt, yTitle, tickFmt) => ({
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: {
              position: "top",
              labels: { boxWidth: 12, usePointStyle: true, font: { size: 11 } }
            },
            tooltip: {
              callbacks: {
                label: (item) => {
                  const name = item.dataset.fullName || item.dataset.label;
                  return name + ": " + tooltipFmt(item.parsed.y);
                }
              }
            },
            zoom: {
              zoom: {
                wheel: { enabled: false },
                pinch: { enabled: false },
                mode: "x",
                drag: {
                  enabled: true,
                  backgroundColor: "rgba(37, 99, 235, 0.15)",
                  borderColor: "rgba(37, 99, 235, 0.55)",
                  borderWidth: 1
                },
                onZoomComplete: ({ chart }) => applyBrush(chart)
              },
              limits: { x: { minRange: 1 } }
            }
          },
          scales: {
            x: {
              ticks: {
                maxRotation: 0,
                minRotation: 0,
                autoSkip: true,
                maxTicksLimit: 8,
                font: { size: 10 }
              },
              grid: { display: false }
            },
            y: {
              beginAtZero: true,
              title: { display: true, text: yTitle },
              ticks: { callback: (v) => tickFmt(v) },
              grid: { color: "rgba(127,127,127,0.15)" }
            }
          }
        });

        const bindReset = (canvas) => {
          if (!canvas) return;
          canvas.addEventListener("dblclick", (e) => {
            e.preventDefault();
            if (typeof window.jormResetTimeRange === "function") window.jormResetTimeRange();
          });
        };

        const tpsEl = document.getElementById("per-model-tps-chart");
        if (tpsEl) {
          new Chart(tpsEl, {
            type: "line",
            data: { labels: data.labels, datasets: lineDatasets("tokensPerSec") },
            options: commonOptions(fmtTps, "Tok/s", (v) => Number(v).toFixed(0))
          });
          bindReset(tpsEl);
        }

        const ttftEl = document.getElementById("per-model-ttft-chart");
        if (ttftEl) {
          new Chart(ttftEl, {
            type: "line",
            data: { labels: data.labels, datasets: lineDatasets("ttftSeconds") },
            options: commonOptions(fmtTtft, "TTFT p50", fmtTtft)
          });
          bindReset(ttftEl);
        }
      })();
    </script>
  HTML
end

def render_model_metric_cells(row)
  <<~HTML.strip
    <td class="num">#{h(format_tps(row["tokens_per_sec_avg"]))}</td>
    <td class="num">#{h(format_ms(row["ttft_p50"]))}</td>
    <td class="num">#{h(format_rate(row["error_rate"]))}</td>
    <td class="num">#{row["requests"]}</td>
    <td class="num">#{format_int(row["input_tokens"])}</td>
    <td class="num">#{format_int(row["output_tokens"])}</td>
    <td class="num">#{format_int(row["cache_read_tokens"])}</td>
    <td class="num">#{format_int(row["reasoning_tokens"])}</td>
  HTML
end

def render_model_table(models, effort_rows:, base_params:, sort_key:, sort_dir:)
  return %(<p class="muted">No model data.</p>) if models.empty?

  headers = MODEL_COLUMN_ORDER.map do |key|
    meta = MODEL_SORT_COLUMNS.fetch(key)
    next_dir = if key == sort_key
                 sort_dir == "asc" ? "desc" : "asc"
               else
                 meta[:numeric] ? "desc" : "asc"
               end
    href = query_string(base_params.merge(sort: key, dir: next_dir))
    sorted = key == sort_key
    indicator = if sorted
                  sort_dir == "asc" ? "↑" : "↓"
                else
                  ""
                end
    classes = ["sortable"]
    classes << "num" if meta[:numeric]
    classes << "sorted" if sorted
    aria = sorted ? %( aria-sort="#{sort_dir == "asc" ? "ascending" : "descending"}") : ""
    <<~HTML.strip
      <th class="#{classes.join(" ")}"#{aria}>
        <a href="/#{h(href)}" title="Sort by #{h(meta[:label])}">#{h(meta[:label])}<span class="sort-indicator">#{indicator}</span></a>
      </th>
    HTML
  end.join

  body = models.map do |m|
    children = efforts_for_model(effort_rows, m["model"], sort_key, sort_dir).map do |e|
      <<~HTML
        <tr class="effort-row" data-parent="#{h(m["model"])}" hidden>
          <td class="mono"><span class="effort-label">#{h(e["think_effort"])}</span></td>
          #{render_model_metric_cells(e)}
        </tr>
      HTML
    end.join

    <<~HTML
      <tr class="model-row">
        <td class="mono">
          <button type="button" class="model-toggle" data-model="#{h(m["model"])}" aria-expanded="false" title="Show think effort breakdown">
            <span class="toggle-marker" aria-hidden="true">▸</span>#{h(m["model"])}
          </button>
        </td>
        #{render_model_metric_cells(m)}
      </tr>
      #{children}
    HTML
  end.join

  <<~HTML
    <table>
      <thead>
        <tr>#{headers}</tr>
      </thead>
      <tbody>#{body}</tbody>
    </table>
  HTML
end

def render_empty_state(filters_active:)
  message = filters_active ? "No responses match these filters." : "No responses recorded yet."
  hint = filters_active ? "Try widening the time range or clearing filters." : "Traffic recorded through jorm will show up here."

  <<~HTML
    <div class="state-panel">
      <p class="state-title">#{h(message)}</p>
      <p class="state-hint">#{h(hint)}</p>
      #{'<a href="/" class="btn btn-ghost">Reset filters</a>' if filters_active}
    </div>
  HTML
end

def render_error_state(error)
  <<~HTML
    <div class="state-panel state-panel-error">
      <p class="state-title">Couldn't load performance data</p>
      <p class="state-hint">#{h(error)}</p>
      <p class="state-hint">#{DEMO_MODE ? "Check that the demo fixture exists (spec/fixtures/llm_performance_demo.json), or regenerate it with ruby spec/fixtures/generate_llm_performance_demo.rb." : "Check that GreptimeDB is running and reachable at the configured host/port. Re-run <code>bin/migrate</code> if timing columns are missing."}</p>
    </div>
  HTML
end

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

server = WEBrick::HTTPServer.new(
  Host: REPORT_HOST,
  Port: REPORT_PORT,
  Logger: WEBrick::Log.new($stderr, WEBrick::Log::INFO),
  AccessLog: [[$stderr, WEBrick::AccessLog::COMMON_LOG_FORMAT]]
)

server.mount_proc "/" do |req, res|
  range_preset = req.query["range"].to_s
  range_preset = DEFAULT_RANGE unless RANGE_PRESETS.key?(range_preset) || range_preset.empty?
  range_preset = DEFAULT_RANGE if range_preset.empty?
  from_raw = req.query["from"].to_s
  to_raw = req.query["to"].to_s
  model_filter = req.query["model"].to_s
  sort_key, sort_dir = normalize_model_sort(req.query["sort"], req.query["dir"])

  from_time, to_time, effective_preset = resolve_range(
    preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw
  )
  range_preset = effective_preset if effective_preset

  rows = []
  all_models = []
  error = nil
  begin
    raw = fetch_rows(from_time: from_time, to_time: to_time)
    rows = raw.map { |r| normalize_row(r) }
    all_models = available_models(rows)
    rows = rows.select { |r| r["model"] == model_filter } unless model_filter.empty?
  rescue StandardError => e
    source = DEMO_MODE ? "demo fixture" : "GreptimeDB"
    error = "Failed to load #{source}: #{e.class}: #{e.message}"
    warn error
  end

  summary = build_summary(rows)
  buckets_info = build_buckets(rows, from_time, to_time)
  models = sort_models(build_per_model(rows), sort_key, sort_dir)
  effort_rows = build_per_model_effort(rows)
  error_breakdown = build_error_breakdown(rows)
  failures = recent_failures(rows)
  model_timeseries = build_per_model_timeseries(rows, from_time, to_time)

  res.status = 200
  res["Content-Type"] = "text/html; charset=utf-8"
  res.body = render_page(
    rows: rows,
    summary: summary,
    buckets_info: buckets_info,
    models: models,
    effort_rows: effort_rows,
    error_breakdown: error_breakdown,
    failures: failures,
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    from_time: from_time,
    to_time: to_time,
    model_filter: model_filter,
    available_models: all_models,
    sort_key: sort_key,
    sort_dir: sort_dir,
    model_timeseries: model_timeseries,
    error: error
  )
end

trap("INT") { server.shutdown }
trap("TERM") { server.shutdown }

puts "jorm LLM performance → http://#{REPORT_HOST}:#{REPORT_PORT}/"
if DEMO_MODE
  puts "  Demo mode: #{DEMO_FIXTURE}"
else
  puts "  GreptimeDB HTTP: http://#{GREPTIME_HOST}:#{GREPTIME_PORT}/v1/sql?db=#{GREPTIME_DB}"
  puts "  Tip: JO_DEMO=1 bin/llm_performance  # synthetic fixture, no DB needed"
end
server.start
