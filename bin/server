#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

HOST="${JO_PROXY_HOST:-127.0.0.1}"
PORT="${JO_PROXY_PORT:-8787}"

echo "jorm proxy: http://${HOST}:${PORT}"
echo "Upstream: ${JO_UPSTREAM_URL:-<unset>}"

# Falcon forks multiple worker processes by default. On macOS, having
# loaded the `pg` gem's libpq (pulled in transitively via GreptimeDB
# recording) before fork() can trip an Objective-C fork-safety check,
# crashing workers with "+[__NSCFConstantString initialize] ...". This
# is the standard workaround; harmless on Linux where it's unset/ignored.
if [[ "$(uname -s)" == "Darwin" ]]; then
  export OBJC_DISABLE_INITIALIZE_FORK_SAFETY="${OBJC_DISABLE_INITIALIZE_FORK_SAFETY:-YES}"
fi

if [[ "${JO_DUMP:-}" == "true" || "${JO_DUMP:-}" == "1" ]]; then
  DUMP_DIR="$(cd "${JO_DUMP_DIR:-./dumps}" 2>/dev/null && pwd || echo "${JO_DUMP_DIR:-./dumps}")"

  # Falcon runs multiple worker processes (forked/threaded) that each load
  # config.ru independently, so each would build its own Recorder. Fixing
  # the dump filename here, before exec, and sharing it via JO_DUMP_FILE
  # means every worker appends to the same file instead of each creating
  # its own.
  export JO_DUMP_FILE="dump-$(ruby -rtime -e 'print Time.now.utc.iso8601(3).tr(":", "-")').jsonl"

  echo "Dump: enabled → ${DUMP_DIR}/${JO_DUMP_FILE}(incl. response)"
fi

exec bundle exec falcon serve --bind "http://${HOST}:${PORT}" --config config.ru
