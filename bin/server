#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

HOST="${DS_PROXY_HOST:-127.0.0.1}"
PORT="${DS_PROXY_PORT:-8787}"

echo "DeepSeek Auto Mode proxy: http://${HOST}:${PORT}"
echo "Upstream: https://api.deepseek.com/anthropic"

if [[ "${DS_DUMP:-}" == "true" || "${DS_DUMP:-}" == "1" ]]; then
  DUMP_DIR="$(cd "${DS_DUMP_DIR:-./dumps}" 2>/dev/null && pwd || echo "${DS_DUMP_DIR:-./dumps}")"
  resp=""
  if [[ "${DS_DUMP_RESPONSE:-}" == "true" || "${DS_DUMP_RESPONSE:-}" == "1" ]]; then
    resp=" (incl. response)"
  fi
  echo "Dump: enabled → ${DUMP_DIR}${resp}"
fi

exec bundle exec falcon serve --bind "http://${HOST}:${PORT}" --config config.ru
