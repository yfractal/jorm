#!/usr/bin/env ruby
# frozen_string_literal: true

# Serves a small HTML report of per-Claude-Code-session cost (OpenRouter only).
#
# Cost comes from OpenRouter's usage.cost extension field on reassembled
# response bodies (not present in Anthropic's native API), so this only
# reports meaningful numbers when JO_UPSTREAM_URL points at OpenRouter.
#
# Talks to GreptimeDB's HTTP SQL API (default :4000) rather than the
# Postgres wire protocol bin/migrate / DbRecorder use, so this script
# needs no `pg` gem -- only Ruby stdlib + WEBrick (a bundled default gem,
# not a Gemfile dependency; no `bundle install` required).
#
# Usage:
#   bin/session_costs
#   JO_REPORT_PORT=5000 bin/session_costs
# Then open http://127.0.0.1:4890/

require "cgi"
require "json"
require "net/http"
require "time"
require "uri"
require "webrick"

REPORT_HOST = ENV.fetch("JO_REPORT_HOST", "127.0.0.1")
REPORT_PORT = Integer(ENV.fetch("JO_REPORT_PORT", "4890"))
GREPTIME_HOST = ENV.fetch("GREPTIMEDB_HTTP_HOST", "127.0.0.1")
GREPTIME_PORT = Integer(ENV.fetch("GREPTIMEDB_HTTP_PORT", "4000"))
GREPTIME_DB = ENV.fetch("GREPTIMEDB_DATABASE", "jorm")

DEFAULT_PER_PAGE = 10
CONTENT_PREVIEW_LEN = 200
UNKNOWN_SESSION_ID = "(unknown)"

RANGE_PRESETS = {
  "1h" => 3600,
  "6h" => 6 * 3600,
  "24h" => 24 * 3600,
  "7d" => 7 * 24 * 3600
}.freeze

DEFAULT_RANGE = "24h"

# ---------------------------------------------------------------------------
# GreptimeDB HTTP SQL client
# ---------------------------------------------------------------------------

def sql_query(sql)
  uri = URI("http://#{GREPTIME_HOST}:#{GREPTIME_PORT}/v1/sql")
  uri.query = URI.encode_www_form(db: GREPTIME_DB, sql: sql)

  response = Net::HTTP.get_response(uri)
  raise "GreptimeDB HTTP #{response.code}: #{response.body[0, 500]}" unless response.is_a?(Net::HTTPSuccess)

  data = JSON.parse(response.body)
  records = data.dig("output", 0, "records")
  return [] unless records

  columns = records.dig("schema", "column_schemas")&.map { |c| c["name"] } || []
  (records["rows"] || []).map { |row| columns.zip(row).to_h }
end

def sql_literal(value)
  "'#{value.to_s.gsub("'", "''")}'"
end

def parse_time_param(raw)
  return nil if raw.nil? || raw.strip.empty?

  Time.parse(raw)
rescue ArgumentError
  nil
end

def resolve_range(preset:, from_raw:, to_raw:)
  from_time = parse_time_param(from_raw)
  to_time = parse_time_param(to_raw)
  return [from_time, to_time, nil] if from_time || to_time

  seconds = RANGE_PRESETS[preset] || RANGE_PRESETS[DEFAULT_RANGE]
  [Time.now.utc - seconds, Time.now.utc, preset]
end

def format_ts(ms_or_time)
  return "—" if ms_or_time.nil?

  t = case ms_or_time
      when Integer then Time.at(ms_or_time / 1000.0).utc
      when Time then ms_or_time.utc
      else
        begin
          Time.parse(ms_or_time.to_s).utc
        rescue ArgumentError
          return ms_or_time.to_s
        end
      end
  t.strftime("%Y-%m-%d %H:%M:%S UTC")
end

def format_cost(cost)
  return "—" if cost.nil?

  format("$%.6f", cost)
end

def format_ms(ms)
  return "—" if ms.nil?

  ms = ms.to_f
  return format("%.0f ms", ms) if ms < 1000

  format("%.2f s", ms / 1000.0)
end

def format_tokens(count)
  return "—" if count.nil?

  count.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
end

def to_f_or_nil(value)
  return nil if value.nil? || value.to_s.empty?

  Float(value)
rescue ArgumentError, TypeError
  nil
end

def to_i_or_nil(value)
  return nil if value.nil? || value.to_s.empty?

  Integer(value)
rescue ArgumentError, TypeError
  nil
end

def mean(values)
  return nil if values.nil? || values.empty?

  values.sum / values.size.to_f
end

# ---------------------------------------------------------------------------
# Row parsing / session grouping
# ---------------------------------------------------------------------------

def flatten_content(content)
  case content
  when String
    content
  when Array
    content.filter_map do |block|
      next unless block.is_a?(Hash)

      block["text"] || block["thinking"]
    end.join(" ")
  else
    content.to_s
  end
end

def last_user_content(req_body)
  return "" unless req_body.is_a?(Hash)

  messages = req_body["messages"]
  return "" unless messages.is_a?(Array)

  last_user = messages.reverse.find { |m| m.is_a?(Hash) && m["role"] == "user" }
  return "" unless last_user

  flatten_content(last_user["content"])
end

def truncate(text, len = CONTENT_PREVIEW_LEN)
  text = text.to_s.gsub(/\s+/, " ").strip
  return text if text.length <= len

  "#{text[0, len]}…"
end

def parse_json_maybe(value)
  case value
  when Hash, Array then value
  when String
    return nil if value.empty?

    JSON.parse(value)
  end
rescue JSON::ParserError
  nil
end

def pretty_json(value)
  JSON.pretty_generate(value)
rescue StandardError
  value.to_s
end

def extract_cost(resp_body)
  cost = resp_body.is_a?(Hash) ? resp_body.dig("usage", "cost") : nil
  cost.nil? ? nil : cost.to_f
end

def extract_usage_tokens(resp_body)
  usage = resp_body.is_a?(Hash) ? resp_body["usage"] : nil
  return { "input_tokens" => nil, "output_tokens" => nil } unless usage.is_a?(Hash)

  {
    "input_tokens" => usage.key?("input_tokens") ? to_i_or_nil(usage["input_tokens"]) : nil,
    "output_tokens" => usage.key?("output_tokens") ? to_i_or_nil(usage["output_tokens"]) : nil
  }
end

def time_range_clauses(from_time, to_time, column: "r.created_at")
  clauses = []
  clauses << "#{column} >= #{sql_literal(from_time.utc.iso8601)}" if from_time
  clauses << "#{column} <= #{sql_literal(to_time.utc.iso8601)}" if to_time
  clauses
end

def fetch_rows(from_time:, to_time:)
  clauses = ["r.path LIKE '/v1/messages%'"]
  clauses.concat(time_range_clauses(from_time, to_time))

  sql = <<~SQL
    SELECT r.jorm_request_id, r.created_at AS req_time, r.headers, r.body AS req_body,
           resp.created_at AS resp_time, resp.body AS resp_body
    FROM requests r
    LEFT JOIN responses resp ON r.jorm_request_id = resp.jorm_request_id
    WHERE #{clauses.join(" AND ")}
    ORDER BY r.created_at ASC
  SQL

  sql_query(sql)
end

# GreptimeDB json_get_string needs a JSONPath. Hyphenated keys must be
# quoted: $."x-claude-code-session-id" (bare $.x-claude-... returns NULL).
SESSION_ID_JSON_PATH = '$."x-claude-code-session-id"'

def session_id_clause(session_id)
  extractor = "json_get_string(r.headers, #{sql_literal(SESSION_ID_JSON_PATH)})"
  if session_id == UNKNOWN_SESSION_ID
    "(#{extractor} IS NULL OR #{extractor} = '')"
  else
    "#{extractor} = #{sql_literal(session_id)}"
  end
end

def fetch_session_rows(session_id:, from_time:, to_time:)
  clauses = [
    "r.path LIKE '/v1/messages%'",
    session_id_clause(session_id)
  ]
  clauses.concat(time_range_clauses(from_time, to_time))

  # model / token columns are denormalized onto responses in newer schemas;
  # this query sticks to columns present on both old and new deployments and
  # derives model from the request/response body in Ruby.
  sql = <<~SQL
    SELECT r.jorm_request_id, r.created_at AS req_time, r.path, r.body AS req_body,
           resp.status, resp.body AS resp_body, resp.ttft_ms, resp.duration_ms,
           resp.error
    FROM requests r
    LEFT JOIN responses resp ON r.jorm_request_id = resp.jorm_request_id
    WHERE #{clauses.join(" AND ")}
    ORDER BY r.created_at ASC
  SQL

  sql_query(sql)
end

def group_sessions(rows)
  sessions = {}

  rows.each do |row|
    headers = parse_json_maybe(row["headers"]) || {}
    session_id = headers["x-claude-code-session-id"].to_s
    session_id = UNKNOWN_SESSION_ID if session_id.empty?

    req_body = parse_json_maybe(row["req_body"])
    resp_body = parse_json_maybe(row["resp_body"])

    content = truncate(last_user_content(req_body))
    cost = extract_cost(resp_body)

    req_time = row["req_time"]
    resp_time = row["resp_time"]
    last_time = resp_time || req_time

    session = sessions[session_id] ||= {
      "session_id" => session_id,
      "created_at" => req_time,
      "last_message_at" => last_time,
      "requests" => [],
      "total_cost" => 0.0
    }

    if req_time && (session["created_at"].nil? || req_time < session["created_at"])
      session["created_at"] = req_time
    end
    if last_time && (session["last_message_at"].nil? || last_time > session["last_message_at"])
      session["last_message_at"] = last_time
    end

    session["requests"] << {
      "time" => req_time,
      "content" => content,
      "cost" => cost
    }
    session["total_cost"] += cost if cost
  end

  sessions.values.sort_by { |s| -(s["last_message_at"] || 0) }
end

def build_session_detail(session_id, rows)
  requests = rows.map.with_index(1) do |row, index|
    req_body = parse_json_maybe(row["req_body"])
    resp_body = parse_json_maybe(row["resp_body"])
    cost = extract_cost(resp_body)
    tokens = extract_usage_tokens(resp_body)
    status = to_i_or_nil(row["status"])
    error = row["error"]
    error = nil if error.respond_to?(:empty?) && error.empty?
    model = req_body.is_a?(Hash) ? req_body["model"].to_s : ""
    model = resp_body["model"].to_s if model.empty? && resp_body.is_a?(Hash)

    {
      "index" => index,
      "jorm_request_id" => row["jorm_request_id"].to_s,
      "time" => row["req_time"],
      "path" => row["path"].to_s,
      "req_body" => req_body,
      "req_body_raw" => row["req_body"],
      "resp_body" => resp_body,
      "resp_body_raw" => row["resp_body"],
      "status" => status,
      "error" => error,
      "model" => model,
      "cost" => cost,
      "input_tokens" => tokens["input_tokens"],
      "output_tokens" => tokens["output_tokens"],
      "ttft_ms" => to_f_or_nil(row["ttft_ms"]),
      "duration_ms" => to_f_or_nil(row["duration_ms"]),
      "has_response" => !(row["resp_body"].nil? || row["resp_body"].to_s.empty?) || !status.nil?
    }
  end

  durations = requests.filter_map { |r| r["duration_ms"] }
  ttfts = requests.filter_map { |r| r["ttft_ms"] }
  costs = requests.filter_map { |r| r["cost"] }
  input_tokens = requests.filter_map { |r| r["input_tokens"] }
  output_tokens = requests.filter_map { |r| r["output_tokens"] }

  {
    "session_id" => session_id,
    "requests" => requests,
    "request_count" => requests.size,
    "total_cost" => costs.empty? ? nil : costs.sum,
    "total_input_tokens" => input_tokens.empty? ? nil : input_tokens.sum,
    "total_output_tokens" => output_tokens.empty? ? nil : output_tokens.sum,
    "avg_duration_ms" => mean(durations),
    "max_duration_ms" => durations.max,
    "avg_ttft_ms" => mean(ttfts)
  }
end

# ---------------------------------------------------------------------------
# HTML helpers
# ---------------------------------------------------------------------------

def h(text)
  CGI.escapeHTML(text.to_s)
end

def query_string(params)
  pairs = params.compact.filter_map do |k, v|
    next if v.nil? || v.to_s.empty?

    "#{CGI.escape(k.to_s)}=#{CGI.escape(v.to_s)}"
  end
  pairs.empty? ? "" : "?#{pairs.join("&")}"
end

def datetime_local_value(time)
  return nil unless time

  time.getlocal.strftime("%Y-%m-%dT%H:%M")
end

def cost_class(cost)
  cost.nil? ? "cost-unknown" : ""
end

def ms_class(ms)
  ms.nil? ? "cost-unknown" : ""
end

def tokens_class(count)
  count.nil? ? "cost-unknown" : ""
end

def short_session_id(session_id)
  return UNKNOWN_SESSION_ID if session_id == UNKNOWN_SESSION_ID
  return session_id if session_id.length <= 12

  "#{session_id[0, 8]}…"
end

def list_params(range_preset:, from_raw:, to_raw:, per_page:, page: nil)
  {
    range: range_preset,
    from: from_raw,
    to: to_raw,
    per_page: per_page.to_s,
    page: page&.to_s
  }
end

def parse_list_query(req)
  range_preset = req.query["range"].to_s
  range_preset = DEFAULT_RANGE unless RANGE_PRESETS.key?(range_preset) || range_preset.empty?
  range_preset = DEFAULT_RANGE if range_preset.empty?
  from_raw = req.query["from"].to_s
  to_raw = req.query["to"].to_s
  from_time, to_time, effective_preset = resolve_range(
    preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw
  )
  range_preset = effective_preset if effective_preset
  page = Integer(req.query["page"] || 1, exception: false) || 1
  per_page = Integer(req.query["per_page"] || DEFAULT_PER_PAGE, exception: false) || DEFAULT_PER_PAGE
  page = 1 if page < 1
  per_page = DEFAULT_PER_PAGE if per_page < 1
  per_page = 100 if per_page > 100

  {
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    from_time: from_time,
    to_time: to_time,
    page: page,
    per_page: per_page
  }
end

# ---------------------------------------------------------------------------
# Content rendering (request / response bodies)
# ---------------------------------------------------------------------------

def render_content_block(block)
  return %(<pre class="content">#{h(block)}</pre>) unless block.is_a?(Hash)

  type = block["type"].to_s
  case type
  when "text"
    %(<div class="block"><span class="block-label">text</span><pre class="content">#{h(block["text"])}</pre></div>)
  when "thinking"
    %(<div class="block"><span class="block-label">thinking</span><pre class="content">#{h(block["thinking"])}</pre></div>)
  when "tool_use"
    input = block["input"]
    input_text = input.is_a?(String) ? input : pretty_json(input)
    <<~HTML
      <div class="block">
        <span class="block-label">tool_use · #{h(block["name"])}</span>
        <pre class="content">#{h(input_text)}</pre>
      </div>
    HTML
  when "tool_result"
    content = block["content"]
    content_text = case content
                   when String then content
                   when Array, Hash then pretty_json(content)
                   else content.to_s
                   end
    label = "tool_result"
    label += " · error" if block["is_error"]
    label += " · #{block["tool_use_id"]}" if block["tool_use_id"]
    <<~HTML
      <div class="block">
        <span class="block-label">#{h(label)}</span>
        <pre class="content">#{h(content_text)}</pre>
      </div>
    HTML
  when "image"
    %(<div class="block"><span class="block-label">image</span><pre class="content">#{h(pretty_json(block))}</pre></div>)
  else
    label = type.empty? ? "block" : type
    %(<div class="block"><span class="block-label">#{h(label)}</span><pre class="content">#{h(pretty_json(block))}</pre></div>)
  end
end

def render_message_content(content)
  case content
  when String
    %(<pre class="content">#{h(content)}</pre>)
  when Array
    content.map { |block| render_content_block(block) }.join
  when nil
    %(<p class="muted">No content</p>)
  else
    %(<pre class="content">#{h(pretty_json(content))}</pre>)
  end
end

def render_system_prompt(system)
  return "" if system.nil?

  body =
    case system
    when String
      %(<pre class="content">#{h(system)}</pre>)
    when Array
      system.map { |block| render_content_block(block) }.join
    else
      %(<pre class="content">#{h(pretty_json(system))}</pre>)
    end

  <<~HTML
    <div class="msg">
      <div class="msg-role">system</div>
      <div class="msg-body scrollable">#{body}</div>
    </div>
  HTML
end

def render_tools_summary(tools)
  return "" unless tools.is_a?(Array) && !tools.empty?

  names = tools.filter_map { |t| t.is_a?(Hash) ? t["name"] : nil }
  label = "#{tools.size} tool#{"s" unless tools.size == 1}"
  label += ": #{names.join(", ")}" unless names.empty?

  %(<p class="tools-summary"><strong>Tools</strong> · #{h(label)}</p>)
end

def render_raw_json_details(label, value)
  text =
    if value.is_a?(Hash) || value.is_a?(Array)
      pretty_json(value)
    elsif value.nil? || value.to_s.empty?
      "(empty)"
    else
      value.to_s
    end

  <<~HTML
    <details class="raw-json">
      <summary>#{h(label)}</summary>
      <pre class="content scrollable">#{h(text)}</pre>
    </details>
  HTML
end

def render_request_body(req)
  body = req["req_body"]
  unless body.is_a?(Hash)
    return <<~HTML
      <p class="muted">No request body recorded.</p>
      #{render_raw_json_details("Raw body", req["req_body_raw"])}
    HTML
  end

  messages = body["messages"]
  message_html =
    if messages.is_a?(Array)
      messages.map do |msg|
        next unless msg.is_a?(Hash)

        <<~HTML
          <div class="msg">
            <div class="msg-role">#{h(msg["role"] || "message")}</div>
            <div class="msg-body scrollable">#{render_message_content(msg["content"])}</div>
          </div>
        HTML
      end.join
    else
      ""
    end

  <<~HTML
    #{render_system_prompt(body["system"])}
    #{message_html}
    #{render_tools_summary(body["tools"])}
    #{render_raw_json_details("Raw JSON", body)}
  HTML
end

def render_usage_line(usage, cost)
  return "" unless usage.is_a?(Hash) || !cost.nil?

  usage = {} unless usage.is_a?(Hash)
  parts = []
  parts << "input #{usage["input_tokens"]}" if usage.key?("input_tokens")
  parts << "output #{usage["output_tokens"]}" if usage.key?("output_tokens")
  parts << "cache read #{usage["cache_read_input_tokens"]}" if usage.key?("cache_read_input_tokens")
  parts << "cache create #{usage["cache_creation_input_tokens"]}" if usage.key?("cache_creation_input_tokens")
  parts << "cost #{format_cost(cost)}" unless cost.nil?
  return "" if parts.empty?

  %(<p class="usage-line"><strong>Usage</strong> · #{h(parts.join(" · "))}</p>)
end

def render_response_body(req)
  body = req["resp_body"]
  error = req["error"]

  unless body.is_a?(Hash) || req["has_response"]
    note = "No response recorded."
    note += " #{error}" if error
    return <<~HTML
      <p class="muted">#{h(note)}</p>
      #{render_raw_json_details("Raw body", req["resp_body_raw"]) if req["resp_body_raw"]}
    HTML
  end

  unless body.is_a?(Hash)
    return <<~HTML
      <pre class="content scrollable">#{h(req["resp_body_raw"])}</pre>
      #{%(<p class="error-text">#{h(error)}</p>) if error}
    HTML
  end

  content_html = render_message_content(body["content"])
  stop = body["stop_reason"]

  <<~HTML
    <div class="msg">
      <div class="msg-role">assistant</div>
      <div class="msg-body scrollable">#{content_html}</div>
    </div>
    #{%(<p class="stop-reason"><strong>Stop reason</strong> · #{h(stop)}</p>) if stop}
    #{render_usage_line(body["usage"], req["cost"])}
    #{%(<p class="error-text">#{h(error)}</p>) if error}
    #{render_raw_json_details("Raw JSON", body)}
  HTML
end

def status_pill(req)
  error = req["error"]
  status = req["status"]

  if error
    %(<span class="pill pill-error" title="#{h(error)}">Error</span>)
  elsif status.nil?
    %(<span class="pill pill-muted">No response</span>)
  elsif status >= 400
    %(<span class="pill pill-error">HTTP #{status}</span>)
  else
    %(<span class="pill pill-ok">OK</span>)
  end
end

def render_request_card(req, open_details:)
  open_attr = open_details ? " open" : ""
  model = req["model"].to_s.empty? ? "—" : req["model"]

  <<~HTML
    <article class="req-card">
      <header class="req-card-header">
        <div class="req-card-title">
          <span class="req-index">##{req["index"]}</span>
          <span class="mono time-cell">#{h(format_ts(req["time"]))}</span>
          <span class="mono model-cell" title="#{h(model)}">#{h(model)}</span>
        </div>
        #{status_pill(req)}
      </header>

      <div class="metrics" aria-label="Request metrics">
        <div class="metric">
          <span class="metric-label">Cost</span>
          <span class="metric-value #{cost_class(req["cost"])}">#{h(format_cost(req["cost"]))}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Latency</span>
          <span class="metric-value #{ms_class(req["duration_ms"])}">#{h(format_ms(req["duration_ms"]))}</span>
        </div>
        <div class="metric">
          <span class="metric-label">TTFT</span>
          <span class="metric-value #{ms_class(req["ttft_ms"])}">#{h(format_ms(req["ttft_ms"]))}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Input tokens</span>
          <span class="metric-value #{tokens_class(req["input_tokens"])}">#{h(format_tokens(req["input_tokens"]))}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Output tokens</span>
          <span class="metric-value #{tokens_class(req["output_tokens"])}">#{h(format_tokens(req["output_tokens"]))}</span>
        </div>
      </div>

      <details class="section-details"#{open_attr}>
        <summary>Request</summary>
        <div class="section-body">#{render_request_body(req)}</div>
      </details>

      <details class="section-details"#{open_attr}>
        <summary>Response</summary>
        <div class="section-body">#{render_response_body(req)}</div>
      </details>
    </article>
  HTML
end

# ---------------------------------------------------------------------------
# Pages
# ---------------------------------------------------------------------------

def render_page(sessions:, page:, per_page:, range_preset:, from_raw:, to_raw:, from_time:, to_time:, error: nil)
  total = sessions.size
  total_pages = [((total + per_page - 1) / per_page), 1].max
  page = page.clamp(1, total_pages)
  slice = sessions[((page - 1) * per_page), per_page] || []
  filters_active = !from_raw.to_s.empty? || !to_raw.to_s.empty? ||
                   (range_preset && range_preset != DEFAULT_RANGE) ||
                   per_page != DEFAULT_PER_PAGE

  grand_total_cost = sessions.sum { |s| s["total_cost"] }
  grand_total_requests = sessions.sum { |s| s["requests"].size }

  base_params = list_params(
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    per_page: per_page
  )

  prev_link = pager_link(base_params, page - 1, "← Prev", enabled: page > 1)
  next_link = pager_link(base_params, page + 1, "Next →", enabled: page < total_pages)

  session_rows = slice.map { |s| render_session_row(s, base_params.merge(page: page.to_s)) }.join

  preset_links = RANGE_PRESETS.keys.map do |key|
    cls = (range_preset == key && from_raw.to_s.empty? && to_raw.to_s.empty?) ? "active" : ""
    href = query_string(base_params.merge(range: key, from: nil, to: nil, page: nil))
    %(<a class="#{cls}" href="/#{h(href)}">#{key}</a>)
  end.join

  body_html =
    if error
      render_error_state(error)
    elsif slice.empty?
      render_empty_state(filters_active: filters_active)
    else
      <<~HTML
        <table>
          <thead>
            <tr>
              <th>Session</th>
              <th>Created</th>
              <th>Last message</th>
              <th class="num">Requests</th>
              <th class="num">Total cost</th>
              <th class="chevron-col" aria-hidden="true"></th>
            </tr>
          </thead>
          <tbody>
            #{session_rows}
          </tbody>
        </table>

        <nav class="pager" aria-label="Session pages">
          <div class="pager-links">#{prev_link}#{next_link}</div>
          <div class="pager-status">Page #{page} of #{total_pages} · #{total} session#{"s" unless total == 1}</div>
        </nav>
      HTML
    end

  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Session costs — jorm</title>
      <style>#{PAGE_CSS}</style>
    </head>
    <body>
      <header class="page-header">
        <h1>Claude Code session costs</h1>
        <p class="subtitle">
          Cost is read from OpenRouter's <code>usage.cost</code> field, grouped by Claude Code session.
          Only meaningful when the upstream is OpenRouter. Click a session to see request and response detail.
        </p>
      </header>

      <section class="stats" aria-label="Summary">
        <div class="stat">
          <span class="stat-value">#{total}</span>
          <span class="stat-label">Session#{"s" unless total == 1}</span>
        </div>
        <div class="stat">
          <span class="stat-value">#{grand_total_requests}</span>
          <span class="stat-label">Request#{"s" unless grand_total_requests == 1}</span>
        </div>
        <div class="stat stat-primary">
          <span class="stat-value">#{h(format_cost(grand_total_cost))}</span>
          <span class="stat-label">Total cost</span>
        </div>
      </section>

      <form class="filter" method="get" action="/">
        <div class="field">
          <label>Range</label>
          <div class="presets">#{preset_links}</div>
        </div>
        <div class="field">
          <label for="from">From</label>
          <input id="from" type="datetime-local" name="from" value="#{h(datetime_local_value(from_time) || from_raw.to_s)}">
        </div>
        <div class="field">
          <label for="to">To</label>
          <input id="to" type="datetime-local" name="to" value="#{h(datetime_local_value(to_time) || to_raw.to_s)}">
        </div>
        <div class="field field-narrow">
          <label for="per_page">Per page</label>
          <input id="per_page" type="number" name="per_page" min="1" max="100" value="#{per_page}">
        </div>
        <input type="hidden" name="range" value="#{h(range_preset || DEFAULT_RANGE)}">
        <div class="field field-actions">
          <button type="submit" class="btn btn-primary">Apply</button>
          #{%(<a href="/" class="btn btn-ghost">Reset</a>) if filters_active}
        </div>
      </form>

      <main>
        #{body_html}
      </main>
    </body>
    </html>
  HTML
end

def pager_link(base_params, target_page, label, enabled:)
  if enabled
    "<a class=\"btn btn-ghost\" href=\"/#{h(query_string(base_params.merge(page: target_page.to_s)))}\">#{label}</a>"
  else
    "<span class=\"btn btn-ghost\" aria-disabled=\"true\">#{label}</span>"
  end
end

def render_session_row(s, list_params)
  request_count = s["requests"].size
  href = "/session#{query_string(list_params.merge(id: s["session_id"]))}"

  <<~HTML
    <tr class="session-row">
      <td class="mono session-id" title="#{h(s["session_id"])}">
        <a class="row-link" href="#{h(href)}">#{h(s["session_id"])}</a>
      </td>
      <td class="mono"><a class="row-link" href="#{h(href)}">#{h(format_ts(s["created_at"]))}</a></td>
      <td class="mono"><a class="row-link" href="#{h(href)}">#{h(format_ts(s["last_message_at"]))}</a></td>
      <td class="num"><a class="row-link" href="#{h(href)}">#{request_count}</a></td>
      <td class="num #{cost_class(s["total_cost"])}"><a class="row-link" href="#{h(href)}">#{h(format_cost(s["total_cost"]))}</a></td>
      <td class="chevron-col"><a class="row-link chevron" href="#{h(href)}" aria-label="View session">›</a></td>
    </tr>
  HTML
end

def render_session_page(detail:, range_preset:, from_raw:, to_raw:, per_page:, page:, error: nil)
  back_href = "/#{query_string(list_params(
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    per_page: per_page,
    page: page
  ))}"

  session_id = detail&.dig("session_id").to_s
  title_id = short_session_id(session_id)
  open_details = detail && detail["request_count"] == 1

  body_html =
    if error
      render_error_state(error)
    elsif detail.nil? || detail["request_count"].zero?
      <<~HTML
        <div class="state-panel">
          <p class="state-title">Session not found</p>
          <p class="state-hint">No requests match this session in the selected time range.</p>
          <a href="#{h(back_href)}" class="btn btn-ghost">Back to sessions</a>
        </div>
      HTML
    else
      cards = detail["requests"].map { |req| render_request_card(req, open_details: open_details) }.join
      <<~HTML
        <section class="stats" aria-label="Session summary">
          <div class="stat">
            <span class="stat-value">#{detail["request_count"]}</span>
            <span class="stat-label">Request#{"s" unless detail["request_count"] == 1}</span>
          </div>
          <div class="stat stat-primary">
            <span class="stat-value #{cost_class(detail["total_cost"])}">#{h(format_cost(detail["total_cost"]))}</span>
            <span class="stat-label">Total cost</span>
          </div>
          <div class="stat">
            <span class="stat-value #{tokens_class(detail["total_input_tokens"])}">#{h(format_tokens(detail["total_input_tokens"]))}</span>
            <span class="stat-label">Input tokens</span>
          </div>
          <div class="stat">
            <span class="stat-value #{tokens_class(detail["total_output_tokens"])}">#{h(format_tokens(detail["total_output_tokens"]))}</span>
            <span class="stat-label">Output tokens</span>
          </div>
          <div class="stat">
            <span class="stat-value #{ms_class(detail["avg_duration_ms"])}">#{h(format_ms(detail["avg_duration_ms"]))}</span>
            <span class="stat-label">Avg latency</span>
          </div>
          <div class="stat">
            <span class="stat-value #{ms_class(detail["avg_ttft_ms"])}">#{h(format_ms(detail["avg_ttft_ms"]))}</span>
            <span class="stat-label">Avg TTFT</span>
          </div>
        </section>

        <div class="req-list">
          #{cards}
        </div>
      HTML
    end

  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Session #{h(title_id)} — jorm</title>
      <style>#{PAGE_CSS}</style>
    </head>
    <body>
      <p class="back-nav">
        <a class="btn btn-ghost" href="#{h(back_href)}">← Back to sessions</a>
      </p>

      <header class="page-header">
        <h1>Session</h1>
        <p class="session-id-full mono">#{h(session_id.empty? ? UNKNOWN_SESSION_ID : session_id)}</p>
      </header>

      <main>
        #{body_html}
      </main>
    </body>
    </html>
  HTML
end

def render_empty_state(filters_active:)
  message = filters_active ? "No sessions match these filters." : "No sessions recorded yet."
  hint = filters_active ? "Try widening the time range or clearing filters." : "Traffic recorded through jorm will show up here."

  <<~HTML
    <div class="state-panel">
      <p class="state-title">#{h(message)}</p>
      <p class="state-hint">#{h(hint)}</p>
      #{'<a href="/" class="btn btn-ghost">Reset filters</a>' if filters_active}
    </div>
  HTML
end

def render_error_state(error)
  <<~HTML
    <div class="state-panel state-panel-error">
      <p class="state-title">Couldn't load session data</p>
      <p class="state-hint">#{h(error)}</p>
      <p class="state-hint">Check that GreptimeDB is running and reachable at the configured host/port.</p>
    </div>
  HTML
end

