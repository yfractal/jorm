# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

server = WEBrick::HTTPServer.new(
  Host: REPORT_HOST,
  Port: REPORT_PORT,
  Logger: WEBrick::Log.new($stderr, WEBrick::Log::INFO),
  AccessLog: [[$stderr, WEBrick::AccessLog::COMMON_LOG_FORMAT]]
)

server.mount_proc "/" do |req, res|
  range_preset = req.query["range"].to_s
  range_preset = DEFAULT_RANGE unless RANGE_PRESETS.key?(range_preset) || range_preset.empty?
  range_preset = DEFAULT_RANGE if range_preset.empty?
  from_raw = req.query["from"].to_s
  to_raw = req.query["to"].to_s
  from_time, to_time, effective_preset = resolve_range(
    preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw
  )
  range_preset = effective_preset if effective_preset
  page = Integer(req.query["page"] || 1, exception: false) || 1
  per_page = Integer(req.query["per_page"] || DEFAULT_PER_PAGE, exception: false) || DEFAULT_PER_PAGE
  page = 1 if page < 1
  per_page = DEFAULT_PER_PAGE if per_page < 1
  per_page = 100 if per_page > 100

  sessions = []
  error = nil
  begin
    rows = fetch_rows(from_time: from_time, to_time: to_time)
    sessions = group_sessions(rows)
  rescue StandardError => e
    error = "Failed to query GreptimeDB: #{e.class}: #{e.message}"
    warn error
  end

  res.status = 200
  res["Content-Type"] = "text/html; charset=utf-8"
  res.body = render_page(
    sessions: sessions,
    page: page,
    per_page: per_page,
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    from_time: from_time,
    to_time: to_time,
    error: error
  )
end

trap("INT") { server.shutdown }
trap("TERM") { server.shutdown }

puts "jorm session costs → http://#{REPORT_HOST}:#{REPORT_PORT}/"
puts "  GreptimeDB HTTP: http://#{GREPTIME_HOST}:#{GREPTIME_PORT}/v1/sql?db=#{GREPTIME_DB}"
server.start
