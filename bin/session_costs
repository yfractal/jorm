#!/usr/bin/env ruby
# frozen_string_literal: true

# Serves a small HTML report of per-Claude-Code-session cost (OpenRouter only).
#
# Cost comes from OpenRouter's usage.cost extension field on reassembled
# response bodies (not present in Anthropic's native API), so this only
# reports meaningful numbers when JO_UPSTREAM_URL points at OpenRouter.
#
# Talks to GreptimeDB's HTTP SQL API (default :4000) rather than the
# Postgres wire protocol bin/migrate / DbRecorder use, so this script
# needs no `pg` gem -- only Ruby stdlib + WEBrick (a bundled default gem,
# not a Gemfile dependency; no `bundle install` required).
#
# Usage:
#   bin/session_costs
#   JO_REPORT_PORT=5000 bin/session_costs
# Then open http://127.0.0.1:4890/

require "cgi"
require "digest"
require "json"
require "net/http"
require "time"
require "uri"
require "webrick"

REPORT_HOST = ENV.fetch("JO_REPORT_HOST", "127.0.0.1")
REPORT_PORT = Integer(ENV.fetch("JO_REPORT_PORT", "4890"))
GREPTIME_HOST = ENV.fetch("GREPTIMEDB_HTTP_HOST", "127.0.0.1")
GREPTIME_PORT = Integer(ENV.fetch("GREPTIMEDB_HTTP_PORT", "4000"))
GREPTIME_DB = ENV.fetch("GREPTIMEDB_DATABASE", "jorm")

DEFAULT_PER_PAGE = 10
CONTENT_PREVIEW_LEN = 200
UNKNOWN_SESSION_ID = "(unknown)"

RANGE_PRESETS = {
  "1h" => 3600,
  "6h" => 6 * 3600,
  "24h" => 24 * 3600,
  "7d" => 7 * 24 * 3600
}.freeze

DEFAULT_RANGE = "24h"

# ---------------------------------------------------------------------------
# GreptimeDB HTTP SQL client
# ---------------------------------------------------------------------------

def sql_query(sql)
  uri = URI("http://#{GREPTIME_HOST}:#{GREPTIME_PORT}/v1/sql")
  uri.query = URI.encode_www_form(db: GREPTIME_DB, sql: sql)

  response = Net::HTTP.get_response(uri)
  raise "GreptimeDB HTTP #{response.code}: #{response.body[0, 500]}" unless response.is_a?(Net::HTTPSuccess)

  data = JSON.parse(response.body)
  records = data.dig("output", 0, "records")
  return [] unless records

  columns = records.dig("schema", "column_schemas")&.map { |c| c["name"] } || []
  (records["rows"] || []).map { |row| columns.zip(row).to_h }
end

def sql_literal(value)
  "'#{value.to_s.gsub("'", "''")}'"
end

def parse_time_param(raw)
  return nil if raw.nil? || raw.strip.empty?

  Time.parse(raw)
rescue ArgumentError
  nil
end

def resolve_range(preset:, from_raw:, to_raw:)
  from_time = parse_time_param(from_raw)
  to_time = parse_time_param(to_raw)
  return [from_time, to_time, nil] if from_time || to_time

  seconds = RANGE_PRESETS[preset] || RANGE_PRESETS[DEFAULT_RANGE]
  [Time.now.utc - seconds, Time.now.utc, preset]
end

def format_ts(ms_or_time)
  return "—" if ms_or_time.nil?

  t = case ms_or_time
      when Integer then Time.at(ms_or_time / 1000.0)
      when Time then ms_or_time
      else
        begin
          Time.parse(ms_or_time.to_s)
        rescue ArgumentError
          return ms_or_time.to_s
        end
      end
  t = t.getlocal
  t.strftime("%Y-%m-%d %H:%M:%S %Z")
end

def format_cost(cost)
  return "—" if cost.nil?

  format("$%.6f", cost)
end

def format_ms(ms)
  return "—" if ms.nil?

  ms = ms.to_f
  return format("%.0f ms", ms) if ms < 1000

  format("%.2f s", ms / 1000.0)
end

def format_tokens(count)
  return "—" if count.nil?

  count.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
end

def format_pct(ratio)
  return "—" if ratio.nil?

  format("%.0f%%", ratio * 100)
end

# Anthropic/OpenRouter: input_tokens is uncached only. Total prompt =
# input + cache_creation + cache_read. Hit rate = cache_read / total.
def total_prompt_tokens(input_tokens:, cache_read_tokens:, cache_creation_tokens:)
  return nil if input_tokens.nil? && cache_read_tokens.nil? && cache_creation_tokens.nil?

  input_tokens.to_i + cache_read_tokens.to_i + cache_creation_tokens.to_i
end

def cache_hit_rate(input_tokens:, cache_read_tokens:, cache_creation_tokens:)
  total = total_prompt_tokens(
    input_tokens: input_tokens,
    cache_read_tokens: cache_read_tokens,
    cache_creation_tokens: cache_creation_tokens
  )
  return nil if total.nil? || total <= 0

  cache_read_tokens.to_i.to_f / total
end

# Tokenizer-free size estimate used for per-section chips. Not exact API
# billing; billed input/output still come from usage when available.
def estimate_tokens(value)
  bytes =
    case value
    when nil, "" then 0
    when String then value.bytesize
    when Numeric, TrueClass, FalseClass then value.to_s.bytesize
    else
      begin
        JSON.generate(value).bytesize
      rescue StandardError
        value.to_s.bytesize
      end
    end
  return 0 if bytes <= 0

  [(bytes / 4.0).ceil, 1].max
end

def token_chip(count, estimated: true)
  return "" if count.nil?

  n = count.to_i
  return "" if n <= 0

  label = estimated ? "~#{format_tokens(n)} tok" : "#{format_tokens(n)} tok"
  title = estimated ? "Estimated from content size (~4 bytes / token)" : "From API usage"
  %(<span class="token-chip#{' token-chip-est' if estimated}" title="#{h(title)}">#{h(label)}</span>)
end

def message_token_payload(msg)
  return msg unless msg.is_a?(Hash)

  { "role" => msg["role"], "content" => msg["content"] }
end

def to_f_or_nil(value)
  return nil if value.nil? || value.to_s.empty?

  Float(value)
rescue ArgumentError, TypeError
  nil
end

def to_i_or_nil(value)
  return nil if value.nil? || value.to_s.empty?

  Integer(value)
rescue ArgumentError, TypeError
  nil
end

def mean(values)
  return nil if values.nil? || values.empty?

  values.sum / values.size.to_f
end

# ---------------------------------------------------------------------------
# Row parsing / session grouping
# ---------------------------------------------------------------------------

def flatten_content(content)
  case content
  when String
    content
  when Array
    content.filter_map do |block|
      next unless block.is_a?(Hash)

      block["text"] || block["thinking"]
    end.join(" ")
  else
    content.to_s
  end
end

def last_user_content(req_body)
  return "" unless req_body.is_a?(Hash)

  messages = req_body["messages"]
  return "" unless messages.is_a?(Array)

  last_user = messages.reverse.find { |m| m.is_a?(Hash) && m["role"] == "user" }
  return "" unless last_user

  flatten_content(last_user["content"])
end

def truncate(text, len = CONTENT_PREVIEW_LEN)
  text = text.to_s.gsub(/\s+/, " ").strip
  return text if text.length <= len

  "#{text[0, len]}…"
end

def parse_json_maybe(value)
  case value
  when Hash, Array then value
  when String
    return nil if value.empty?

    JSON.parse(value)
  end
rescue JSON::ParserError
  nil
end

def pretty_json(value)
  JSON.pretty_generate(value)
rescue StandardError
  value.to_s
end

def extract_cost(resp_body)
  cost = resp_body.is_a?(Hash) ? resp_body.dig("usage", "cost") : nil
  cost.nil? ? nil : cost.to_f
end

def extract_usage_tokens(resp_body)
  usage = resp_body.is_a?(Hash) ? resp_body["usage"] : nil
  unless usage.is_a?(Hash)
    return {
      "input_tokens" => nil,
      "output_tokens" => nil,
      "cache_read_tokens" => nil,
      "cache_creation_tokens" => nil
    }
  end

  # JSON null → 0 when the key is present (OpenRouter often sends null).
  read_token = lambda do |key|
    return nil unless usage.key?(key)

    to_i_or_nil(usage[key]) || 0
  end

  {
    "input_tokens" => read_token.call("input_tokens"),
    "output_tokens" => read_token.call("output_tokens"),
    "cache_read_tokens" => read_token.call("cache_read_input_tokens"),
    "cache_creation_tokens" => read_token.call("cache_creation_input_tokens")
  }
end

def time_range_clauses(from_time, to_time, column: "r.created_at")
  clauses = []
  clauses << "#{column} >= #{sql_literal(from_time.utc.iso8601)}" if from_time
  clauses << "#{column} <= #{sql_literal(to_time.utc.iso8601)}" if to_time
  clauses
end

def fetch_rows(from_time:, to_time:)
  clauses = ["r.path LIKE '/v1/messages%'"]
  clauses.concat(time_range_clauses(from_time, to_time))

  sql = <<~SQL
    SELECT r.jorm_request_id, r.created_at AS req_time, r.headers, r.body AS req_body,
           resp.created_at AS resp_time, resp.body AS resp_body
    FROM requests r
    LEFT JOIN responses resp ON r.jorm_request_id = resp.jorm_request_id
    WHERE #{clauses.join(" AND ")}
    ORDER BY r.created_at ASC
  SQL

  sql_query(sql)
end

# GreptimeDB json_get_string needs a JSONPath. Hyphenated keys must be
# quoted: $."x-claude-code-session-id" (bare $.x-claude-... returns NULL).
SESSION_ID_JSON_PATH = '$."x-claude-code-session-id"'

def session_id_clause(session_id)
  extractor = "json_get_string(r.headers, #{sql_literal(SESSION_ID_JSON_PATH)})"
  if session_id == UNKNOWN_SESSION_ID
    "(#{extractor} IS NULL OR #{extractor} = '')"
  else
    "#{extractor} = #{sql_literal(session_id)}"
  end
end

def fetch_session_rows(session_id:, from_time:, to_time:)
  clauses = [
    "r.path LIKE '/v1/messages%'",
    session_id_clause(session_id)
  ]
  clauses.concat(time_range_clauses(from_time, to_time))

  # model / token columns are denormalized onto responses in newer schemas;
  # this query sticks to columns present on both old and new deployments and
  # derives model from the request/response body in Ruby.
  sql = <<~SQL
    SELECT r.jorm_request_id, r.created_at AS req_time, r.path, r.body AS req_body,
           resp.status, resp.body AS resp_body, resp.ttft_ms, resp.duration_ms,
           resp.error
    FROM requests r
    LEFT JOIN responses resp ON r.jorm_request_id = resp.jorm_request_id
    WHERE #{clauses.join(" AND ")}
    ORDER BY r.created_at ASC
  SQL

  sql_query(sql)
end

def group_sessions(rows)
  sessions = {}

  rows.each do |row|
    headers = parse_json_maybe(row["headers"]) || {}
    session_id = headers["x-claude-code-session-id"].to_s
    session_id = UNKNOWN_SESSION_ID if session_id.empty?

    req_body = parse_json_maybe(row["req_body"])
    resp_body = parse_json_maybe(row["resp_body"])

    content = truncate(last_user_content(req_body))
    cost = extract_cost(resp_body)

    req_time = row["req_time"]
    resp_time = row["resp_time"]
    last_time = resp_time || req_time

    session = sessions[session_id] ||= {
      "session_id" => session_id,
      "created_at" => req_time,
      "last_message_at" => last_time,
      "requests" => [],
      "total_cost" => 0.0
    }

    if req_time && (session["created_at"].nil? || req_time < session["created_at"])
      session["created_at"] = req_time
    end
    if last_time && (session["last_message_at"].nil? || last_time > session["last_message_at"])
      session["last_message_at"] = last_time
    end

    session["requests"] << {
      "time" => req_time,
      "content" => content,
      "cost" => cost
    }
    session["total_cost"] += cost if cost
  end

  sessions.values.sort_by { |s| -(s["last_message_at"] || 0) }
end

def build_session_detail(session_id, rows)
  requests = rows.map.with_index(1) do |row, index|
    req_body = parse_json_maybe(row["req_body"])
    resp_body = parse_json_maybe(row["resp_body"])
    cost = extract_cost(resp_body)
    tokens = extract_usage_tokens(resp_body)
    status = to_i_or_nil(row["status"])
    error = row["error"]
    error = nil if error.respond_to?(:empty?) && error.empty?
    model = req_body.is_a?(Hash) ? req_body["model"].to_s : ""
    model = resp_body["model"].to_s if model.empty? && resp_body.is_a?(Hash)

    hit_rate = cache_hit_rate(
      input_tokens: tokens["input_tokens"],
      cache_read_tokens: tokens["cache_read_tokens"],
      cache_creation_tokens: tokens["cache_creation_tokens"]
    )
    prompt_tokens = total_prompt_tokens(
      input_tokens: tokens["input_tokens"],
      cache_read_tokens: tokens["cache_read_tokens"],
      cache_creation_tokens: tokens["cache_creation_tokens"]
    )

    {
      "index" => index,
      "jorm_request_id" => row["jorm_request_id"].to_s,
      "time" => row["req_time"],
      "path" => row["path"].to_s,
      "req_body" => req_body,
      "req_body_raw" => row["req_body"],
      "resp_body" => resp_body,
      "resp_body_raw" => row["resp_body"],
      "status" => status,
      "error" => error,
      "model" => model,
      "cost" => cost,
      "input_tokens" => tokens["input_tokens"],
      "output_tokens" => tokens["output_tokens"],
      "cache_read_tokens" => tokens["cache_read_tokens"],
      "cache_creation_tokens" => tokens["cache_creation_tokens"],
      "prompt_tokens" => prompt_tokens,
      "cache_hit_rate" => hit_rate,
      "ttft_ms" => to_f_or_nil(row["ttft_ms"]),
      "duration_ms" => to_f_or_nil(row["duration_ms"]),
      "has_response" => !(row["resp_body"].nil? || row["resp_body"].to_s.empty?) || !status.nil?
    }
  end

  durations = requests.filter_map { |r| r["duration_ms"] }
  ttfts = requests.filter_map { |r| r["ttft_ms"] }
  costs = requests.filter_map { |r| r["cost"] }
  input_tokens = requests.filter_map { |r| r["input_tokens"] }
  output_tokens = requests.filter_map { |r| r["output_tokens"] }

  {
    "session_id" => session_id,
    "requests" => requests,
    "request_count" => requests.size,
    "total_cost" => costs.empty? ? nil : costs.sum,
    "total_input_tokens" => input_tokens.empty? ? nil : input_tokens.sum,
    "total_output_tokens" => output_tokens.empty? ? nil : output_tokens.sum,
    "avg_duration_ms" => mean(durations),
    "max_duration_ms" => durations.max,
    "avg_ttft_ms" => mean(ttfts)
  }
end

# ---------------------------------------------------------------------------
# Shared history (exact prior message / system dedupe)
# ---------------------------------------------------------------------------

def deep_sort_for_json(value)
  case value
  when Hash
    value.keys.map(&:to_s).sort.each_with_object({}) do |key, out|
      raw = value.key?(key) ? value[key] : value[key.to_sym]
      out[key] = deep_sort_for_json(raw)
    end
  when Array
    value.map { |item| deep_sort_for_json(item) }
  else
    value
  end
end

def fingerprint(value)
  Digest::SHA256.hexdigest(JSON.generate(deep_sort_for_json(value)))
end

def message_role(message)
  message.is_a?(Hash) ? (message["role"] || "message").to_s : "message"
end

# Annotates each request with system_ref and message_segments so the UI can
# replace exact copies of earlier content with links to the first occurrence.
def annotate_shared_history!(detail)
  return detail unless detail.is_a?(Hash)

  requests = detail["requests"]
  return detail unless requests.is_a?(Array)

  canonical = {}

  requests.each do |req|
    body = req["req_body"]
    req_index = req["index"]

    if body.is_a?(Hash) && !body["system"].nil?
      sys_fp = fingerprint(body["system"])
      if canonical.key?(sys_fp)
        src = canonical[sys_fp]
        req["system_ref"] = { "from_req" => src["req"], "kind" => "system" }
      else
        canonical[sys_fp] = { "req" => req_index, "kind" => "system" }
        req["system_ref"] = nil
      end
    else
      req["system_ref"] = nil
    end

    messages = body.is_a?(Hash) ? body["messages"] : nil
    unless messages.is_a?(Array)
      req["message_segments"] = []
      next
    end

    annotated = messages.each_with_index.map do |msg, msg_index|
      fp = fingerprint(msg)
      if canonical.key?(fp)
        src = canonical[fp]
        {
          "ref" => true,
          "index" => msg_index,
          "message" => msg,
          "role" => message_role(msg),
          "from_req" => src["req"],
          "from_index" => src["index"]
        }
      else
        canonical[fp] = { "req" => req_index, "index" => msg_index, "kind" => "message" }
        {
          "ref" => false,
          "index" => msg_index,
          "message" => msg,
          "role" => message_role(msg)
        }
      end
    end

    req["message_segments"] = collapse_message_ref_runs(annotated)
  end

  detail
end

def collapse_message_ref_runs(annotated)
  segments = []
  i = 0
  while i < annotated.length
    item = annotated[i]
    unless item["ref"]
      segments << {
        "type" => "full",
        "index" => item["index"],
        "message" => item["message"],
        "role" => item["role"]
      }
      i += 1
      next
    end

    from_req = item["from_req"]
    from_index = item["from_index"]
    j = i + 1
    expect = from_index + 1
    while j < annotated.length
      nxt = annotated[j]
      break unless nxt["ref"] && nxt["from_req"] == from_req && nxt["from_index"] == expect

      expect += 1
      j += 1
    end

    run = annotated[i...j]
    segments << {
      "type" => "ref",
      "from_req" => from_req,
      "from_index" => from_index,
      "count" => run.length,
      "roles" => run.map { |r| r["role"] },
      "messages" => run.map { |r| r["message"] },
      "start_index" => item["index"]
    }
    i = j
  end
  segments
end

# ---------------------------------------------------------------------------
# HTML helpers
# ---------------------------------------------------------------------------

def h(text)
  CGI.escapeHTML(text.to_s)
end

def query_string(params)
  pairs = params.compact.filter_map do |k, v|
    next if v.nil? || v.to_s.empty?

    "#{CGI.escape(k.to_s)}=#{CGI.escape(v.to_s)}"
  end
  pairs.empty? ? "" : "?#{pairs.join("&")}"
end

def datetime_local_value(time)
  return nil unless time

  time.getlocal.strftime("%Y-%m-%dT%H:%M")
end

def cost_class(cost)
  cost.nil? ? "cost-unknown" : ""
end

def ms_class(ms)
  ms.nil? ? "cost-unknown" : ""
end

def tokens_class(count)
  count.nil? ? "cost-unknown" : ""
end

def cache_hit_title(req)
  rate = req["cache_hit_rate"]
  return "No usage data" if rate.nil?

  cache_read = req["cache_read_tokens"].to_i
  total = req["prompt_tokens"] || (
    req["input_tokens"].to_i + cache_read + req["cache_creation_tokens"].to_i
  )
  "#{format_tokens(cache_read)} / #{format_tokens(total)} tokens from cache"
end

def cache_hit_chip(req)
  rate = req["cache_hit_rate"]
  return "" if rate.nil?

  %(<span class="cache-hit-chip" title="#{h(cache_hit_title(req))}">cache hit #{h(format_pct(rate))}</span>)
end

def short_session_id(session_id)
  return UNKNOWN_SESSION_ID if session_id == UNKNOWN_SESSION_ID
  return session_id if session_id.length <= 12

  "#{session_id[0, 8]}…"
end

def list_params(range_preset:, from_raw:, to_raw:, per_page:, page: nil)
  {
    range: range_preset,
    from: from_raw,
    to: to_raw,
    per_page: per_page.to_s,
    page: page&.to_s
  }
end

def parse_list_query(req)
  range_preset = req.query["range"].to_s
  range_preset = DEFAULT_RANGE unless RANGE_PRESETS.key?(range_preset) || range_preset.empty?
  range_preset = DEFAULT_RANGE if range_preset.empty?
  from_raw = req.query["from"].to_s
  to_raw = req.query["to"].to_s
  from_time, to_time, effective_preset = resolve_range(
    preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw
  )
  range_preset = effective_preset if effective_preset
  page = Integer(req.query["page"] || 1, exception: false) || 1
  per_page = Integer(req.query["per_page"] || DEFAULT_PER_PAGE, exception: false) || DEFAULT_PER_PAGE
  page = 1 if page < 1
  per_page = DEFAULT_PER_PAGE if per_page < 1
  per_page = 100 if per_page > 100

  {
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    from_time: from_time,
    to_time: to_time,
    page: page,
    per_page: per_page
  }
end

# ---------------------------------------------------------------------------
# Content rendering (request / response bodies)
# ---------------------------------------------------------------------------

def skill_load_pattern
  /
    Base\ directory\ for\ this\ skill:\ [^\n]+
    (?:\n(?!Base\ directory\ for\ this\ skill:)[^\n]*)*
  /x
end

# Classify plain text that appears inside a user message. Claude Code packs
# reminders, slash-commands, and skill payloads into role=user alongside the
# actual typed prompt — we want the typed prompt to stand out.
#
# Returns one of:
#   :user_input  - text the human typed
#   :user_command - a slash command the human typed (e.g. /dummy)
#   :command     - command *output* (local-command-stdout) and similar
#   :skill, :system_reminder, :harness - text Claude Code injected itself
#   :empty
HUMAN_INPUT_KINDS = %i[user_input user_command].freeze

# Synthetic user-role text Claude Code generates on its own: auto-title and
# "welcome back" recap requests, skill de-dup notices, interrupts, etc.
HARNESS_TEXT_PATTERNS = [
  /\A<session>\s*\n/,
  /\AThe user stepped away and is coming back\./,
  %r{\ASkill\s+/\S+\s+is already loaded}i,
  /\A\[Request interrupted by user/,
  /\A\s*<(?:local-command-caveat|task-notification|forked-skill-launch|system-notification)\b/i,
  /\ACaveat: The messages below were generated by the user while running local commands/
].freeze

def classify_user_text(text)
  stripped = text.to_s.strip
  return :empty if stripped.empty?
  return :skill if skill_load_only?(text) || stripped.include?("Base directory for this skill:")
  return :system_reminder if stripped.match?(/\A<system-reminder>/)
  return :harness if HARNESS_TEXT_PATTERNS.any? { |pattern| stripped.match?(pattern) }

  # Command *output* is never typed by the human.
  return :command if stripped.match?(%r{\A</?(?:local-command-stdout|local-command-stderr)\b}i) ||
                     stripped.match?(%r{<local-command-stdout\b}i)
  # <command-name>/dummy</command-name> is what Claude Code records when the
  # human types a slash command.
  return :user_command if stripped.match?(%r{\A</?(?:command-name|command-message|command-args)\b}i) ||
                          stripped.match?(%r{<command-name>}i)

  :user_input
end

def human_input_kind?(kind)
  HUMAN_INPUT_KINDS.include?(kind)
end

# "/dummy" (+ args) instead of the raw <command-message> markup.
def command_display_text(text)
  name = text.to_s[%r{<command-name>\s*([^<]+?)\s*</command-name>}i, 1]
  args = text.to_s[%r{<command-args>\s*(.*?)\s*</command-args>}im, 1]
  return text.to_s unless name

  [name, args].compact.reject(&:empty?).join(" ")
end

def user_message_has_input?(content)
  case content
  when String
    human_input_kind?(classify_user_text(content))
  when Array
    content.any? do |block|
      next false unless block.is_a?(Hash) && block["type"].to_s == "text"

      human_input_kind?(classify_user_text(block["text"]))
    end
  else
    false
  end
end

def render_text_content(text)
  text = text.to_s
  return %(<pre class="content"></pre>) if text.empty?

  html = +""
  last = 0
  text.to_enum(:scan, skill_load_pattern).each do
    match = Regexp.last_match
    before = text[last...match.begin(0)]
    html << %(<pre class="content">#{h(before)}</pre>) unless before.nil? || before.strip.empty?
    html << render_skill_load_block(match[0])
    last = match.end(0)
  end
  after = text[last..]
  html << %(<pre class="content">#{h(after)}</pre>) unless after.nil? || after.strip.empty?
  html
end

# True when the string is only one or more skill-load sections (plus whitespace).
def skill_load_only?(text)
  remainder = text.to_s.dup
  remainder.gsub!(skill_load_pattern, "")
  remainder.strip.empty? && text.to_s.match?(skill_load_pattern)
end

def render_meta_text_block(text, kind:)
  case kind
  when :system_reminder
    badge = "System reminder"
    css = "block-reminder"
  when :command
    badge = "Command"
    css = "block-command"
    # Prefer a short label from <command-name>/foo</command-name> when present.
    if (m = text.to_s.match(%r{<command-name>\s*([^<]+?)\s*</command-name>}i))
      badge = "Command · #{m[1].strip}"
    elsif (m = text.to_s.match(%r{<local-command-stdout>}i))
      badge = "Command output"
    end
  when :harness
    badge = "Claude Code injected"
    css = "block-harness"
  else
    badge = "Text"
    css = "block-text"
  end

  <<~HTML
    <div class="block #{css}">
      <div class="block-header">
        <span class="block-badge">#{h(badge)}</span>
        #{token_chip(estimate_tokens(text))}
      </div>
      <pre class="content">#{h(text)}</pre>
    </div>
  HTML
end

def user_input_badge(text, kind)
  return "Typed" unless kind == :user_command

  name = text.to_s[%r{<command-name>\s*([^<]+?)\s*</command-name>}i, 1]
  name ? "Slash · #{name}" : "Slash command"
end

def render_user_input_block(text, kind: :user_input)
  shown = kind == :user_command ? command_display_text(text) : text.to_s
  <<~HTML
    <div class="block block-user-input">
      <div class="block-header">
        <span class="block-badge">#{h(user_input_badge(text, kind))}</span>
        #{token_chip(estimate_tokens(text))}
      </div>
      <pre class="content user-input-text">#{h(shown)}</pre>
    </div>
  HTML
end

def render_text_block(text, role: nil)
  text = text.to_s
  if skill_load_only?(text)
    return render_text_content(text)
  end

  if role.to_s == "user"
    kind = classify_user_text(text)
    case kind
    when :user_input, :user_command
      return render_user_input_block(text, kind: kind)
    when :system_reminder, :command, :harness
      return render_meta_text_block(text, kind: kind)
    when :skill
      return render_text_content(text)
    end
  end

  inner = render_text_content(text)
  <<~HTML
    <div class="block block-text">
      <div class="block-header">
        <span class="block-badge">Text</span>
        #{token_chip(estimate_tokens(text))}
      </div>
      <div class="block-body">#{inner}</div>
    </div>
  HTML
end

def skill_name_from_path(path)
  name = path.to_s.split("/").reject(&:empty?).last.to_s
  name.empty? ? "skill" : name
end

def parse_skill_load(raw)
  lines = raw.to_s.sub(/\A\n+/, "").sub(/\n+\z/, "").split("\n", -1)
  path_line = lines.first.to_s
  path = path_line.sub(/\ABase directory for this skill:\s*/, "").strip
  skill_name = skill_name_from_path(path)

  body_lines = lines.drop(1)
  body_lines.shift while body_lines.first&.strip&.empty?
  if body_lines.first&.match?(/\A#\s*Instructions\s*\z/i)
    body_lines.shift
    body_lines.shift while body_lines.first&.strip&.empty?
  end
  body = body_lines.join("\n").sub(/\A\n+/, "").sub(/\n+\z/, "")

  { "name" => skill_name, "path" => path, "body" => body }
end

def extract_skill_loads_from_text(text)
  text.to_s.to_enum(:scan, skill_load_pattern).map do
    parse_skill_load(Regexp.last_match[0])
  end
end

# Skills that first appear in this request (not ones only resent via shared
# history refs). Order preserved; duplicates by path collapsed.
def request_loaded_skills(req)
  messages =
    if req["message_segments"].is_a?(Array) && !req["message_segments"].empty?
      req["message_segments"].filter_map do |seg|
        next unless seg.is_a?(Hash) && seg["type"] == "full"

        seg["message"]
      end
    else
      body = req["req_body"]
      body.is_a?(Hash) && body["messages"].is_a?(Array) ? body["messages"] : []
    end

  seen = {}
  skills = []
  messages.each do |msg|
    next unless msg.is_a?(Hash)

    content = msg["content"]
    texts =
      case content
      when String then [content]
      when Array
        content.filter_map { |b| b["text"] if b.is_a?(Hash) && b["type"].to_s == "text" }
      else
        []
      end

    texts.each do |text|
      extract_skill_loads_from_text(text).each do |skill|
        key = skill["path"].empty? ? skill["name"] : skill["path"]
        next if seen[key]

        seen[key] = true
        skills << skill
      end
    end
  end
  skills
end

def skill_load_chip(skills)
  return "" if skills.nil? || skills.empty?

  skills.map do |skill|
    label = "skill #{skill["name"]}"
    title = skill["path"].empty? ? "Skill loaded" : skill["path"]
    %(<span class="skill-load-chip mono" title="#{h(title)}">#{h(label)}</span>)
  end.join
end

# Human-typed prompts / slash commands that first appear in this request
# (shared-history refs are skipped so earlier turns are not repeated).
def request_human_inputs(req)
  messages =
    if req["message_segments"].is_a?(Array) && !req["message_segments"].empty?
      req["message_segments"].filter_map do |seg|
        next unless seg.is_a?(Hash) && seg["type"] == "full"

        seg["message"]
      end
    else
      body = req["req_body"]
      body.is_a?(Hash) && body["messages"].is_a?(Array) ? body["messages"] : []
    end

  seen = {}
  inputs = []
  messages.each do |msg|
    next unless msg.is_a?(Hash) && msg["role"].to_s == "user"

    content = msg["content"]
    texts =
      case content
      when String then [content]
      when Array
        content.filter_map { |b| b["text"] if b.is_a?(Hash) && b["type"].to_s == "text" }
      else
        []
      end

    texts.each do |text|
      kind = classify_user_text(text)
      next unless human_input_kind?(kind)

      shown = kind == :user_command ? command_display_text(text) : text.to_s.strip
      next if shown.empty?

      key = shown
      next if seen[key]

      seen[key] = true
      inputs << { "kind" => kind, "text" => shown }
    end
  end
  inputs
end

def human_input_chip(inputs)
  return "" if inputs.nil? || inputs.empty?

  inputs.map do |input|
    label = truncate(input["text"], 48)
    %(<span class="human-input-chip" title="#{h(input["text"])}">#{h(label)}</span>)
  end.join
end

def render_skill_load_block(raw)
  parsed = parse_skill_load(raw)
  path = parsed["path"]
  skill_name = parsed["name"]
  body = parsed["body"]

  <<~HTML
    <div class="block block-skill">
      <div class="block-header">
        <span class="block-badge">Skill loaded</span>
        <span class="block-meta mono" title="#{h(path)}">#{h(skill_name)}</span>
        #{token_chip(estimate_tokens(raw))}
      </div>
      #{%(<p class="skill-path mono">#{h(path)}</p>) unless path.empty?}
      #{%(<pre class="content">#{h(body)}</pre>) unless body.empty?}
    </div>
  HTML
end

def render_content_block(block, role: nil)
  return render_text_content(block) unless block.is_a?(Hash)

  type = block["type"].to_s
  case type
  when "text"
    render_text_block(block["text"], role: role)
  when "thinking"
    thinking = block["thinking"]
    <<~HTML
      <div class="block block-thinking">
        <div class="block-header">
          <span class="block-badge">Thinking</span>
          #{token_chip(estimate_tokens(thinking))}
        </div>
        <pre class="content">#{h(thinking)}</pre>
      </div>
    HTML
  when "tool_use"
    input = block["input"]
    input_text = input.is_a?(String) ? input : pretty_json(input)
    name = block["name"].to_s
    name = "tool" if name.empty?
    <<~HTML
      <div class="block block-tool-use">
        <div class="block-header">
          <span class="block-badge">Tool use</span>
          <span class="block-meta mono" title="#{h(name)}">#{h(name)}</span>
          #{token_chip(estimate_tokens({ "name" => name, "input" => input }))}
        </div>
        <pre class="content">#{h(input_text)}</pre>
      </div>
    HTML
  when "tool_result"
    content = block["content"]
    content_html =
      case content
      when String
        render_text_content(content)
      when Array
        # Tool output is never human input, so don't pass the user role down.
        content.map { |inner| render_content_block(inner) }.join
      when Hash
        %(<pre class="content">#{h(pretty_json(content))}</pre>)
      else
        %(<pre class="content">#{h(content)}</pre>)
      end
    is_error = !!block["is_error"]
    error_class = is_error ? " block-tool-result-error" : ""
    badge = is_error ? "Tool result · error" : "Tool result"
    meta = block["tool_use_id"].to_s
    meta_html = meta.empty? ? "" : %(<span class="block-meta mono" title="#{h(meta)}">#{h(meta)}</span>)
    <<~HTML
      <div class="block block-tool-result#{error_class}">
        <div class="block-header">
          <span class="block-badge">#{h(badge)}</span>
          #{meta_html}
          #{token_chip(estimate_tokens(content))}
        </div>
        <div class="block-body">#{content_html}</div>
      </div>
    HTML
  when "image"
    <<~HTML
      <div class="block block-image">
        <div class="block-header">
          <span class="block-badge">Image</span>
          #{token_chip(estimate_tokens(block))}
        </div>
        <pre class="content">#{h(pretty_json(block))}</pre>
      </div>
    HTML
  else
    label = type.empty? ? "Block" : type
    <<~HTML
      <div class="block block-other">
        <div class="block-header">
          <span class="block-badge">#{h(label)}</span>
          #{token_chip(estimate_tokens(block))}
        </div>
        <pre class="content">#{h(pretty_json(block))}</pre>
      </div>
    HTML
  end
end

def render_message_content(content, role: nil)
  case content
  when String
    if role.to_s == "user"
      kind = classify_user_text(content)
      case kind
      when :user_input, :user_command then return render_user_input_block(content, kind: kind)
      when :system_reminder, :command, :harness then return render_meta_text_block(content, kind: kind)
      when :skill then return render_text_content(content)
      end
    end
    render_text_content(content)
  when Array
    content.map { |block| render_content_block(block, role: role) }.join
  when nil
    %(<p class="muted">No content</p>)
  else
    %(<pre class="content">#{h(pretty_json(content))}</pre>)
  end
end

def render_system_prompt(system, req_index:)
  return "" if system.nil?

  body =
    case system
    when String
      %(<pre class="content">#{h(system)}</pre>)
    when Array
      system.map { |block| render_content_block(block) }.join
    else
      %(<pre class="content">#{h(pretty_json(system))}</pre>)
    end

  <<~HTML
    <div class="msg" id="req-#{req_index}-system">
      <div class="msg-role">
        <span>system</span>
        #{token_chip(estimate_tokens(system))}
      </div>
      <div class="msg-body scrollable">#{body}</div>
    </div>
  HTML
end

def render_full_message(msg, req_index:, msg_index:)
  return "" unless msg.is_a?(Hash)

  role = (msg["role"] || "message").to_s
  has_input = role == "user" && user_message_has_input?(msg["content"])
  msg_class = has_input ? "msg msg-user-input" : "msg"
  role_label = has_input ? "user · typed" : role

  <<~HTML
    <div class="#{msg_class}" id="req-#{req_index}-m-#{msg_index}">
      <div class="msg-role">
        <span>#{h(role_label)}</span>
        #{token_chip(estimate_tokens(message_token_payload(msg)))}
      </div>
      <div class="msg-body scrollable">#{render_message_content(msg["content"], role: role)}</div>
    </div>
  HTML
end

def format_role_sequence(roles)
  roles = Array(roles).map(&:to_s)
  return "" if roles.empty?

  if roles.length <= 5
    roles.join(" → ")
  else
    "#{roles.first(2).join(" → ")} → … → #{roles.last(2).join(" → ")} (#{roles.length})"
  end
end

def render_shared_history_chip(segment)
  from_req = segment["from_req"]
  from_index = segment["from_index"]
  count = segment["count"]
  roles = segment["roles"]
  target_id = "req-#{from_req}-m-#{from_index}"
  tok = Array(segment["messages"]).sum { |m| estimate_tokens(message_token_payload(m)) }

  label =
    if count == 1
      "Earlier in ##{from_req} · #{roles.first}"
    else
      "Earlier in ##{from_req} · #{count} messages (#{format_role_sequence(roles)})"
    end

  expanded = segment["messages"].map do |msg|
    role = message_role(msg)
    has_input = role == "user" && user_message_has_input?(msg.is_a?(Hash) ? msg["content"] : msg)
    msg_class = has_input ? "msg msg-user-input" : "msg"
    role_label = has_input ? "user · typed" : role
    content = msg.is_a?(Hash) ? msg["content"] : msg
    <<~HTML
      <div class="#{msg_class}">
        <div class="msg-role">
          <span>#{h(role_label)}</span>
          #{token_chip(estimate_tokens(message_token_payload(msg)))}
        </div>
        <div class="msg-body scrollable">#{render_message_content(content, role: role)}</div>
      </div>
    HTML
  end.join

  <<~HTML
    <div class="history-chip" data-target="#{h(target_id)}" data-source-req="#{from_req}">
      <div class="history-chip-main">
        <span class="history-chip-label">#{h(label)} #{token_chip(tok)}</span>
        <span class="history-chip-actions">
          <button type="button" class="history-link" data-action="jump">Jump to source</button>
          <button type="button" class="history-link" data-action="toggle">Show here</button>
        </span>
      </div>
      <div class="history-chip-expand" hidden>
        #{expanded}
      </div>
    </div>
  HTML
end

def render_system_ref_chip(from_req, system: nil)
  target_id = "req-#{from_req}-system"
  chip = system.nil? ? "" : token_chip(estimate_tokens(system))
  <<~HTML
    <div class="history-chip" data-target="#{h(target_id)}" data-source-req="#{from_req}">
      <div class="history-chip-main">
        <span class="history-chip-label">Same system prompt as ##{from_req} #{chip}</span>
        <span class="history-chip-actions">
          <button type="button" class="history-link" data-action="jump">Jump to source</button>
        </span>
      </div>
    </div>
  HTML
end

def render_tools_summary(tools)
  return "" unless tools.is_a?(Array) && !tools.empty?

  chips = tools.filter_map do |tool|
    next unless tool.is_a?(Hash)

    name = tool["name"].to_s
    next if name.empty?

    desc = tool["description"].to_s.gsub(/\s+/, " ").strip
    title = desc.empty? ? name : "#{name} — #{desc[0, 240]}#{'…' if desc.length > 240}"
    %(<span class="tool-chip mono" title="#{h(title)}">#{h(name)}</span>)
  end.join

  return "" if chips.empty?

  <<~HTML
    <div class="tools-panel">
      <div class="tools-panel-header">
        <span class="block-badge tools-badge">Tools</span>
        <span class="tools-count">#{tools.size} available</span>
        #{token_chip(estimate_tokens(tools))}
      </div>
      <div class="tools-chips">#{chips}</div>
    </div>
  HTML
end

def render_raw_json_details(label, value)
  text =
    if value.is_a?(Hash) || value.is_a?(Array)
      pretty_json(value)
    elsif value.nil? || value.to_s.empty?
      "(empty)"
    else
      value.to_s
    end

  <<~HTML
    <details class="raw-json">
      <summary>#{h(label)}</summary>
      <pre class="content scrollable">#{h(text)}</pre>
    </details>
  HTML
end

def render_request_body(req)
  body = req["req_body"]
  req_index = req["index"]
  unless body.is_a?(Hash)
    return <<~HTML
      <p class="muted">No request body recorded.</p>
      #{render_raw_json_details("Raw body", req["req_body_raw"])}
    HTML
  end

  system_html =
    if req["system_ref"]
      render_system_ref_chip(req["system_ref"]["from_req"], system: body["system"])
    else
      render_system_prompt(body["system"], req_index: req_index)
    end

  segments = req["message_segments"]
  message_html =
    if segments.is_a?(Array) && !segments.empty?
      segments.map do |seg|
        if seg["type"] == "ref"
          render_shared_history_chip(seg)
        else
          render_full_message(seg["message"], req_index: req_index, msg_index: seg["index"])
        end
      end.join
    elsif body["messages"].is_a?(Array)
      body["messages"].each_with_index.map do |msg, msg_index|
        next unless msg.is_a?(Hash)

        render_full_message(msg, req_index: req_index, msg_index: msg_index)
      end.join
    else
      ""
    end

  <<~HTML
    #{system_html}
    #{message_html}
    #{render_tools_summary(body["tools"])}
    #{render_raw_json_details("Raw JSON", body)}
  HTML
end

def render_usage_line(usage, cost)
  return "" unless usage.is_a?(Hash) || !cost.nil?

  usage = {} unless usage.is_a?(Hash)
  parts = []
  parts << "input #{usage["input_tokens"]}" if usage.key?("input_tokens")
  parts << "output #{usage["output_tokens"]}" if usage.key?("output_tokens")
  parts << "cache read #{usage["cache_read_input_tokens"]}" if usage.key?("cache_read_input_tokens")
  parts << "cache create #{usage["cache_creation_input_tokens"]}" if usage.key?("cache_creation_input_tokens")

  hit = cache_hit_rate(
    input_tokens: usage.key?("input_tokens") ? to_i_or_nil(usage["input_tokens"]) : nil,
    cache_read_tokens:
      usage.key?("cache_read_input_tokens") ? to_i_or_nil(usage["cache_read_input_tokens"]) : nil,
    cache_creation_tokens:
      usage.key?("cache_creation_input_tokens") ? to_i_or_nil(usage["cache_creation_input_tokens"]) : nil
  )
  parts << "cache hit #{format_pct(hit)}" unless hit.nil?

  parts << "cost #{format_cost(cost)}" unless cost.nil?
  return "" if parts.empty?

  %(<p class="usage-line"><strong>Usage</strong> · #{h(parts.join(" · "))}</p>)
end

def render_response_body(req)
  body = req["resp_body"]
  error = req["error"]

  unless body.is_a?(Hash) || req["has_response"]
    note = "No response recorded."
    note += " #{error}" if error
    return <<~HTML
      <p class="muted">#{h(note)}</p>
      #{render_raw_json_details("Raw body", req["resp_body_raw"]) if req["resp_body_raw"]}
    HTML
  end

  unless body.is_a?(Hash)
    return <<~HTML
      <pre class="content scrollable">#{h(req["resp_body_raw"])}</pre>
      #{%(<p class="error-text">#{h(error)}</p>) if error}
    HTML
  end

  content_html = render_message_content(body["content"])
  stop = body["stop_reason"]
  # Prefer billed output tokens when present; otherwise estimate from content.
  resp_tok =
    if req["output_tokens"]
      token_chip(req["output_tokens"], estimated: false)
    else
      token_chip(estimate_tokens(body["content"]))
    end

  <<~HTML
    <div class="msg">
      <div class="msg-role">
        <span>assistant</span>
        #{resp_tok}
      </div>
      <div class="msg-body scrollable">#{content_html}</div>
    </div>
    #{%(<p class="stop-reason"><strong>Stop reason</strong> · #{h(stop)}</p>) if stop}
    #{render_usage_line(body["usage"], req["cost"])}
    #{%(<p class="error-text">#{h(error)}</p>) if error}
    #{render_raw_json_details("Raw JSON", body)}
  HTML
end

def status_pill(req)
  error = req["error"]
  status = req["status"]

  if error
    %(<span class="pill pill-error" title="#{h(error)}">Error</span>)
  elsif status.nil?
    %(<span class="pill pill-muted">No response</span>)
  elsif status >= 400
    %(<span class="pill pill-error">HTTP #{status}</span>)
  else
    %(<span class="pill pill-ok">OK</span>)
  end
end

def render_request_card(req, open_details:)
  open_attr = open_details ? " open" : ""
  model = req["model"].to_s.empty? ? "—" : req["model"]
  req_index = req["index"]
  body = req["req_body"]
  # Prefer total prompt tokens (uncached + cache write + cache read).
  # Anthropic's input_tokens alone understates the request when cache hits.
  req_tok =
    if req["prompt_tokens"]
      token_chip(req["prompt_tokens"], estimated: false)
    else
      token_chip(estimate_tokens(body))
    end
  resp_tok =
    if req["output_tokens"]
      token_chip(req["output_tokens"], estimated: false)
    else
      token_chip(estimate_tokens(req["resp_body"] || req["resp_body_raw"]))
    end

  <<~HTML
    <article class="req-card" id="req-#{req_index}">
      <header class="req-card-header">
        <div class="req-card-title">
          <span class="req-index">##{req_index}</span>
          <span class="mono time-cell">#{h(format_ts(req["time"]))}</span>
          <span class="mono model-cell" title="#{h(model)}">#{h(model)}</span>
        </div>
        #{status_pill(req)}
      </header>

      <details class="section-details request-section"#{open_attr}>
        <summary>Request #{req_tok}#{human_input_chip(request_human_inputs(req))}#{skill_load_chip(request_loaded_skills(req))}#{cache_hit_chip(req)}</summary>
        <div class="section-body">#{render_request_body(req)}</div>
      </details>

      <details class="section-details"#{open_attr}>
        <summary>Response #{resp_tok}</summary>
        <div class="section-body">#{render_response_body(req)}</div>
      </details>
    </article>
  HTML
end

# ---------------------------------------------------------------------------
# Pages
# ---------------------------------------------------------------------------

def render_page(sessions:, page:, per_page:, range_preset:, from_raw:, to_raw:, from_time:, to_time:, error: nil)
  total = sessions.size
  total_pages = [((total + per_page - 1) / per_page), 1].max
  page = page.clamp(1, total_pages)
  slice = sessions[((page - 1) * per_page), per_page] || []
  filters_active = !from_raw.to_s.empty? || !to_raw.to_s.empty? ||
                   (range_preset && range_preset != DEFAULT_RANGE) ||
                   per_page != DEFAULT_PER_PAGE

  grand_total_cost = sessions.sum { |s| s["total_cost"] }
  grand_total_requests = sessions.sum { |s| s["requests"].size }

  base_params = list_params(
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    per_page: per_page
  )

  prev_link = pager_link(base_params, page - 1, "← Prev", enabled: page > 1)
  next_link = pager_link(base_params, page + 1, "Next →", enabled: page < total_pages)

  session_rows = slice.map { |s| render_session_row(s, base_params.merge(page: page.to_s)) }.join

  preset_links = RANGE_PRESETS.keys.map do |key|
    cls = (range_preset == key && from_raw.to_s.empty? && to_raw.to_s.empty?) ? "active" : ""
    href = query_string(base_params.merge(range: key, from: nil, to: nil, page: nil))
    %(<a class="#{cls}" href="/#{h(href)}">#{key}</a>)
  end.join

  body_html =
    if error
      render_error_state(error)
    elsif slice.empty?
      render_empty_state(filters_active: filters_active)
    else
      <<~HTML
        <table>
          <thead>
            <tr>
              <th>Session</th>
              <th>Created</th>
              <th>Last message</th>
              <th class="num">Requests</th>
              <th class="num">Total cost</th>
              <th class="chevron-col" aria-hidden="true"></th>
            </tr>
          </thead>
          <tbody>
            #{session_rows}
          </tbody>
        </table>

        <nav class="pager" aria-label="Session pages">
          <div class="pager-links">#{prev_link}#{next_link}</div>
          <div class="pager-status">Page #{page} of #{total_pages} · #{total} session#{"s" unless total == 1}</div>
        </nav>
      HTML
    end

  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Session costs — jorm</title>
      <style>#{PAGE_CSS}</style>
    </head>
    <body>
      <header class="page-header">
        <h1>Claude Code session costs</h1>
        <p class="subtitle">
          Cost is read from OpenRouter's <code>usage.cost</code> field, grouped by Claude Code session.
          Only meaningful when the upstream is OpenRouter. Click a session to see request and response detail.
        </p>
      </header>

      <section class="stats" aria-label="Summary">
        <div class="stat">
          <span class="stat-value">#{total}</span>
          <span class="stat-label">Session#{"s" unless total == 1}</span>
        </div>
        <div class="stat">
          <span class="stat-value">#{grand_total_requests}</span>
          <span class="stat-label">Request#{"s" unless grand_total_requests == 1}</span>
        </div>
        <div class="stat stat-primary">
          <span class="stat-value">#{h(format_cost(grand_total_cost))}</span>
          <span class="stat-label">Total cost</span>
        </div>
      </section>

      <form class="filter" method="get" action="/">
        <div class="field">
          <label>Range</label>
          <div class="presets">#{preset_links}</div>
        </div>
        <div class="field">
          <label for="from">From</label>
          <input id="from" type="datetime-local" name="from" value="#{h(datetime_local_value(from_time) || from_raw.to_s)}">
        </div>
        <div class="field">
          <label for="to">To</label>
          <input id="to" type="datetime-local" name="to" value="#{h(datetime_local_value(to_time) || to_raw.to_s)}">
        </div>
        <div class="field field-narrow">
          <label for="per_page">Per page</label>
          <input id="per_page" type="number" name="per_page" min="1" max="100" value="#{per_page}">
        </div>
        <input type="hidden" name="range" value="#{h(range_preset || DEFAULT_RANGE)}">
        <div class="field field-actions">
          <button type="submit" class="btn btn-primary">Apply</button>
          #{%(<a href="/" class="btn btn-ghost">Reset</a>) if filters_active}
        </div>
      </form>

      <main>
        #{body_html}
      </main>
    </body>
    </html>
  HTML
end

def pager_link(base_params, target_page, label, enabled:)
  if enabled
    "<a class=\"btn btn-ghost\" href=\"/#{h(query_string(base_params.merge(page: target_page.to_s)))}\">#{label}</a>"
  else
    "<span class=\"btn btn-ghost\" aria-disabled=\"true\">#{label}</span>"
  end
end

def render_session_row(s, list_params)
  request_count = s["requests"].size
  href = "/session#{query_string(list_params.merge(id: s["session_id"]))}"

  <<~HTML
    <tr class="session-row">
      <td class="mono session-id" title="#{h(s["session_id"])}">
        <a class="row-link" href="#{h(href)}">#{h(s["session_id"])}</a>
      </td>
      <td class="mono"><a class="row-link" href="#{h(href)}">#{h(format_ts(s["created_at"]))}</a></td>
      <td class="mono"><a class="row-link" href="#{h(href)}">#{h(format_ts(s["last_message_at"]))}</a></td>
      <td class="num"><a class="row-link" href="#{h(href)}">#{request_count}</a></td>
      <td class="num #{cost_class(s["total_cost"])}"><a class="row-link" href="#{h(href)}">#{h(format_cost(s["total_cost"]))}</a></td>
      <td class="chevron-col"><a class="row-link chevron" href="#{h(href)}" aria-label="View session">›</a></td>
    </tr>
  HTML
end

def render_session_page(detail:, range_preset:, from_raw:, to_raw:, per_page:, page:, error: nil)
  back_href = "/#{query_string(list_params(
    range_preset: range_preset,
    from_raw: from_raw,
    to_raw: to_raw,
    per_page: per_page,
    page: page
  ))}"

  session_id = detail&.dig("session_id").to_s
  title_id = short_session_id(session_id)
  open_details = detail && detail["request_count"] == 1

  body_html =
    if error
      render_error_state(error)
    elsif detail.nil? || detail["request_count"].zero?
      <<~HTML
        <div class="state-panel">
          <p class="state-title">Session not found</p>
          <p class="state-hint">No requests match this session in the selected time range.</p>
          <a href="#{h(back_href)}" class="btn btn-ghost">Back to sessions</a>
        </div>
      HTML
    else
      cards = detail["requests"].map { |req| render_request_card(req, open_details: open_details) }.join
      <<~HTML
        <section class="stats" aria-label="Session summary">
          <div class="stat">
            <span class="stat-value">#{detail["request_count"]}</span>
            <span class="stat-label">Request#{"s" unless detail["request_count"] == 1}</span>
          </div>
          <div class="stat stat-primary">
            <span class="stat-value #{cost_class(detail["total_cost"])}">#{h(format_cost(detail["total_cost"]))}</span>
            <span class="stat-label">Total cost</span>
          </div>
          <div class="stat">
            <span class="stat-value #{tokens_class(detail["total_input_tokens"])}">#{h(format_tokens(detail["total_input_tokens"]))}</span>
            <span class="stat-label">Input tokens</span>
          </div>
          <div class="stat">
            <span class="stat-value #{tokens_class(detail["total_output_tokens"])}">#{h(format_tokens(detail["total_output_tokens"]))}</span>
            <span class="stat-label">Output tokens</span>
          </div>
          <div class="stat">
            <span class="stat-value #{ms_class(detail["avg_duration_ms"])}">#{h(format_ms(detail["avg_duration_ms"]))}</span>
            <span class="stat-label">Avg latency</span>
          </div>
          <div class="stat">
            <span class="stat-value #{ms_class(detail["avg_ttft_ms"])}">#{h(format_ms(detail["avg_ttft_ms"]))}</span>
            <span class="stat-label">Avg TTFT</span>
          </div>
        </section>


        <div class="req-list">
          #{cards}
        </div>
      HTML
    end

  <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1">
      <title>Session #{h(title_id)} — jorm</title>
      <style>#{PAGE_CSS}</style>
    </head>
    <body>
      <p class="back-nav">
        <a class="btn btn-ghost" href="#{h(back_href)}">← Back to sessions</a>
      </p>

      <header class="page-header">
        <h1>Session</h1>
        <p class="session-id-full mono">#{h(session_id.empty? ? UNKNOWN_SESSION_ID : session_id)}</p>
      </header>

      <main>
        #{body_html}
      </main>
      <script>
      (function () {
        function openRequestSection(el) {
          var details = el && el.closest ? el.closest(".request-section") : null;
          if (details) details.open = true;
        }
        function flash(el) {
          if (!el) return;
          el.classList.remove("flash");
          void el.offsetWidth;
          el.classList.add("flash");
          setTimeout(function () { el.classList.remove("flash"); }, 1200);
        }
        document.addEventListener("click", function (e) {
          var btn = e.target.closest("[data-action]");
          if (!btn) return;
          var chip = btn.closest(".history-chip");
          if (!chip) return;
          var action = btn.getAttribute("data-action");
          if (action === "jump") {
            e.preventDefault();
            var targetId = chip.getAttribute("data-target");
            var target = targetId ? document.getElementById(targetId) : null;
            if (!target) return;
            openRequestSection(target);
            var card = target.closest(".req-card");
            if (card) card.scrollIntoView({ behavior: "smooth", block: "start" });
            setTimeout(function () {
              target.scrollIntoView({ behavior: "smooth", block: "center" });
              flash(target);
            }, 50);
          } else if (action === "toggle") {
            e.preventDefault();
            var expand = chip.querySelector(".history-chip-expand");
            if (!expand) return;
            var open = expand.hasAttribute("hidden");
            if (open) {
              expand.removeAttribute("hidden");
              btn.textContent = "Hide";
            } else {
              expand.setAttribute("hidden", "");
              btn.textContent = "Show here";
            }
          }
        });
      })();
      </script>
    </body>
    </html>
  HTML
end

def render_empty_state(filters_active:)
  message = filters_active ? "No sessions match these filters." : "No sessions recorded yet."
  hint = filters_active ? "Try widening the time range or clearing filters." : "Traffic recorded through jorm will show up here."

  <<~HTML
    <div class="state-panel">
      <p class="state-title">#{h(message)}</p>
      <p class="state-hint">#{h(hint)}</p>
      #{'<a href="/" class="btn btn-ghost">Reset filters</a>' if filters_active}
    </div>
  HTML
end

def render_error_state(error)
  <<~HTML
    <div class="state-panel state-panel-error">
      <p class="state-title">Couldn't load session data</p>
      <p class="state-hint">#{h(error)}</p>
      <p class="state-hint">Check that GreptimeDB is running and reachable at the configured host/port.</p>
    </div>
  HTML
end

