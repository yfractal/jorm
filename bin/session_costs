# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

server = WEBrick::HTTPServer.new(
  Host: REPORT_HOST,
  Port: REPORT_PORT,
  Logger: WEBrick::Log.new($stderr, WEBrick::Log::INFO),
  AccessLog: [[$stderr, WEBrick::AccessLog::COMMON_LOG_FORMAT]]
)

server.mount_proc "/" do |req, res|
  q = parse_list_query(req)

  sessions = []
  error = nil
  begin
    rows = fetch_rows(from_time: q[:from_time], to_time: q[:to_time])
    sessions = group_sessions(rows)
  rescue StandardError => e
    error = "Failed to query GreptimeDB: #{e.class}: #{e.message}"
    warn error
  end

  res.status = 200
  res["Content-Type"] = "text/html; charset=utf-8"
  res.body = render_page(
    sessions: sessions,
    page: q[:page],
    per_page: q[:per_page],
    range_preset: q[:range_preset],
    from_raw: q[:from_raw],
    to_raw: q[:to_raw],
    from_time: q[:from_time],
    to_time: q[:to_time],
    error: error
  )
end

server.mount_proc "/session" do |req, res|
  q = parse_list_query(req)
  session_id = req.query["id"].to_s
  session_id = UNKNOWN_SESSION_ID if session_id.empty?

  detail = nil
  error = nil
  begin
    rows = fetch_session_rows(
      session_id: session_id,
      from_time: q[:from_time],
      to_time: q[:to_time]
    )
    detail = build_session_detail(session_id, rows)
  rescue StandardError => e
    error = "Failed to query GreptimeDB: #{e.class}: #{e.message}"
    warn error
    detail = { "session_id" => session_id, "requests" => [], "request_count" => 0 }
  end

  res.status = 200
  res["Content-Type"] = "text/html; charset=utf-8"
  res.body = render_session_page(
    detail: detail,
    range_preset: q[:range_preset],
    from_raw: q[:from_raw],
    to_raw: q[:to_raw],
    per_page: q[:per_page],
    page: q[:page],
    error: error
  )
end

trap("INT") { server.shutdown }
trap("TERM") { server.shutdown }

puts "jorm session costs → http://#{REPORT_HOST}:#{REPORT_PORT}/"
puts "  GreptimeDB HTTP: http://#{GREPTIME_HOST}:#{GREPTIME_PORT}/v1/sql?db=#{GREPTIME_DB}"
server.start
